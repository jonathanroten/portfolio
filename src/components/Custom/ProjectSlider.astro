---
import type { HTMLAttributes } from "astro/types";
import Slider from "@/components/Interactive/Slider.astro";
import Img from "@/components/Media/Img.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

type HeadingTag = "h2" | "h3" | "h4" | "h5" | "h6";

type ImageSource = ImageMetadata | string;

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * The project's images, one slide each, cropped to 16:9. `src` takes an
   * imported asset, a remote `http(s)` URL, or a path to a file in `public/`.
   * Leave `alt` unset on decorative images — renders `alt=""`.
   */
  images?: { src: ImageSource; alt?: string }[];
  /** The project's title, between the slider's controls. Inline markup is rendered. */
  heading?: string;
  /** Body copy under the heading. Inline markup is rendered. */
  text?: string;
  /** Heading level, for the page outline. Every project heading is the same size. */
  headingTag?: HeadingTag;
};

const {
  render = true,
  images,
  heading,
  text,
  headingTag = "h4",
  class: className,
  ...rest
} = Astro.props;

const label = heading?.replace(/<[^>]*>/g, "") || "Project images";
---

{
  render && images?.length && (
    <Slider
      label={label}
      align="center"
      loop
      xsmall={1.2}
      large={1.7}
      class:list={["project-slider_wrap", "gap-1", "gap-row-4", className]}
      {...rest}
    >
      {images.map(({ src, alt }) => (
        <Img
          src={src}
          alt={alt}
          width={1920}
          height={1080}
          class="ratio-16-9"
        />
      ))}
      {(heading || text) && (
        <Fragment slot="caption">
          {heading && (
            <Heading tag={headingTag} variant="h6">
              <Fragment set:html={heading} />
            </Heading>
          )}
          {text && (
            <Paragraph>
              <Fragment set:html={text} />
            </Paragraph>
          )}
        </Fragment>
      )}
    </Slider>
  )
}
