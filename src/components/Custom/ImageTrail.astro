---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const items = await slotContent(Astro.slots);
---

{
  render && items && (
    <div
      class:list={["image-trail_wrap", className]}
      aria-hidden="true"
      {...rest}
    >
      <Fragment set:html={items} />
    </div>
  )
}

<script>
  for (const trail of document.querySelectorAll<HTMLElement>(
    ".image-trail_wrap",
  )) {
    const images = Array.from(
      trail.querySelectorAll<HTMLElement>(":scope > img"),
    );
    if (images.length === 0) continue;

    // Mouse tracking is scoped to the section the trail lives in, so the
    // effect only runs while the cursor is over that section (and never
    // while it's scrolled out of view).
    const scope = trail.closest<HTMLElement>(".section") ?? trail;

    const config = { threshold: 32, life: 750, flipMs: 1500 };
    const total = images.length;

    // Flipbook below this width, trail at/above it — matches Grid's 64rem breakpoint.
    const desktopQuery = window.matchMedia("(width >= 64rem)");
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    const pointer = { x: 0, y: 0 };
    const last = { x: 0, y: 0 };
    const timers = new WeakMap<HTMLElement, number>();
    let index = 0;
    let stackTop = 1;
    let hasMoved = false;
    let flipTimer: number | null = null;
    let frame: number | null = null;
    let mouseHandler: ((event: MouseEvent) => void) | null = null;

    // ---- Flipbook mode (narrow): one centered frame at a time ----
    const advance = () => {
      images.forEach((img, i) =>
        img.classList.toggle("is-active", i === index),
      );
      index = (index + 1) % total;
    };

    // ---- Trail mode (wide): hard-cut image at the cursor ----
    const showImage = () => {
      const img = images[index];
      // Offsets are measured from the trail's own center, not the viewport's,
      // so the effect stays correct however the trail is laid out on the page.
      const rect = trail.getBoundingClientRect();
      const offsetX = pointer.x - (rect.left + rect.width / 2);
      const offsetY = pointer.y - (rect.top + rect.height / 2);
      img.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      img.style.zIndex = String(stackTop);
      stackTop += 1;
      img.classList.add("is-active");
      const existing = timers.get(img);
      if (existing) window.clearTimeout(existing);
      timers.set(
        img,
        window.setTimeout(() => img.classList.remove("is-active"), config.life),
      );
      index = (index + 1) % total;
    };

    const render = () => {
      if (hasMoved) {
        const distance = Math.hypot(pointer.x - last.x, pointer.y - last.y);
        if (distance > config.threshold) {
          showImage();
          last.x = pointer.x;
          last.y = pointer.y;
        }
      }
      frame = window.requestAnimationFrame(render);
    };

    // Fully stop whichever mode is running so the two can never overlap.
    const teardown = () => {
      if (frame) {
        window.cancelAnimationFrame(frame);
        frame = null;
      }
      if (flipTimer) {
        window.clearInterval(flipTimer);
        flipTimer = null;
      }
      if (mouseHandler) {
        scope.removeEventListener("mousemove", mouseHandler);
        mouseHandler = null;
      }
      images.forEach((img) => {
        const existing = timers.get(img);
        if (existing) window.clearTimeout(existing);
        img.classList.remove("is-active");
        img.style.transform = "";
        img.style.zIndex = "";
      });
      index = 0;
      stackTop = 1;
      hasMoved = false;
    };

    const run = (flipbook: boolean) => {
      teardown();
      if (flipbook) {
        advance();
        if (!reducedMotionQuery.matches) {
          flipTimer = window.setInterval(advance, config.flipMs);
        }
        return;
      }
      // Tracked on the containing section rather than the trail itself,
      // since the trail is pointer-events: none and never receives pointer
      // events directly. Scoping to the section (rather than window) keeps
      // the effect from firing while the cursor is elsewhere on the page.
      mouseHandler = (event) => {
        // clientX/clientY are browser-reported pixels — runtime values, not CSS.
        pointer.x = event.clientX;
        pointer.y = event.clientY;
        if (!hasMoved) {
          last.x = pointer.x;
          last.y = pointer.y;
          hasMoved = true;
        }
      };
      scope.addEventListener("mousemove", mouseHandler);
      frame = window.requestAnimationFrame(render);
    };

    // Rebuild only when the mode ACTUALLY changes, so resizing within one
    // mode never tears down (or duplicates) the running experience.
    let currentFlip: boolean | null = null;
    const applyMode = () => {
      const flipbook = !desktopQuery.matches;
      if (flipbook === currentFlip) return;
      currentFlip = flipbook;
      run(flipbook);
    };

    // Debounce so a viewport that settles over a moment on load (a resizing
    // container or window animating open) commits to ONE final mode instead
    // of briefly showing the wrong one — this stops an image flashing on load.
    let settleTimer: number | null = null;
    const scheduleApply = () => {
      if (settleTimer) window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(applyMode, 120);
    };

    // 'change' handles the breakpoint cross; 'resize' is a fallback for
    // environments that don't fire it. applyMode is a no-op unless the
    // mode actually changed, so this stays cheap.
    desktopQuery.addEventListener("change", scheduleApply);
    window.addEventListener("resize", scheduleApply);
    // A reduced-motion toggle mid-session starts or stops the flipbook timer.
    reducedMotionQuery.addEventListener("change", () => {
      if (currentFlip !== null) run(currentFlip);
    });
    scheduleApply();
  }
</script>

<style is:global>
  @layer components {
    .image-trail_wrap {
      /* Display size of each image. Override from outside for a different fit. */
      --_img-width: 18.75rem;
      --_img-ratio: 4/5;
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;

      > img {
        opacity: 0;
        width: var(--_img-width);
        background: var(--background-skeleton);
        will-change: transform, opacity;
        aspect-ratio: var(--_img-ratio);
        position: absolute;

        &.is-active {
          opacity: 1;
        }
      }
    }

    /* Flipbook mode: a larger, centered frame sitting in normal flow rather
       than overlaid on whatever the trail sits in front of. */
    @media (width < 64rem) {
      .image-trail_wrap {
        --_img-width: 68vw;
        position: relative;
        aspect-ratio: var(--_img-ratio);
        width: 100%;
      }
    }
  }
</style>
