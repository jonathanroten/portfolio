---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Position in the case study order, shown as `01`.
   *
   * @min 1
   * @int
   */
  number?: number;
  /** Case study title. */
  heading?: string;
  /** The case study description, as Home shows it. */
  description?: string;
  /** Services provided. */
  services?: string[];
  /** How the work was taken on, such as `Freelance`. */
  engagement?: string;
}

const {
  render = true,
  number,
  heading,
  description,
  services,
  engagement,
  class: className,
  ...rest
} = Astro.props;

const image = await slotContent(Astro.slots);
---

{render && heading && (
  <div class:list={["intro-case-study_wrap", className]} {...rest}>
    {number !== undefined && (
      <span
        class="intro-case-study_number text-style-h5"
        data-view-transition="number"
        data-page-reveal="0"
      >
        {String(number).padStart(2, "0")}
      </span>
    )}
    <h1
      class="intro-case-study_title text-style-h5"
      data-view-transition="title"
      data-page-reveal="0"
    >
      {heading}
    </h1>
    {description && (
      <p class="intro-case-study_text text-style-h4" data-page-reveal="1">
        {description}
      </p>
    )}
    {(!!services?.length || !!engagement) && (
      <dl class="intro-case-study_meta" data-page-reveal="2">
        {!!services?.length && (
          <div>
            <dt class="sr-only">Services Provided</dt>
            <dd class="text-style-main">{services.join(", ")}</dd>
          </div>
        )}
        {engagement && (
          <div>
            <dt class="sr-only">Engagement</dt>
            <dd class="text-style-main">{engagement}</dd>
          </div>
        )}
      </dl>
    )}
    {image && (
      <div class="intro-case-study_image">
        <Fragment set:html={image} />
      </div>
    )}
  </div>
)}

<style is:global>
  @layer components {
    .intro-case-study_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
      .intro-case-study_title {
        grid-column: 2;
      }
      .intro-case-study_text {
        grid-column: 1 / -1;
        max-width: 50ch;
        margin-top: var(--space-5);
      }
      .intro-case-study_meta {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        margin-top: var(--space-8);
      }
      .intro-case-study_image {
        grid-column: 1 / -1;
        margin-top: var(--site-gutter);
      }
      :root.case-study-arriving & {
        .intro-case-study_text,
        .intro-case-study_meta {
          animation: page-reveal var(--page-reveal-duration)
            var(--page-reveal-ease)
            calc(var(--page-stagger) * 3 * var(--page-next-pace)) both;
        }
        .intro-case-study_meta {
          animation-delay: calc(
            var(--page-stagger) * 4 * var(--page-next-pace)
          );
        }
        .intro-case-study_image {
          animation: intro-case-study-rise
            calc(var(--page-duration-slow) * var(--page-next-pace))
            var(--page-ease)
            calc(var(--page-stagger) * 5 * var(--page-next-pace)) both;
        }
      }
      :root[data-page-arriving] & {
        .intro-case-study_image {
          animation: intro-case-study-rise var(--page-duration-slow)
            var(--page-ease) calc(var(--page-reveal) + var(--page-stagger) * 3)
            both;
        }
      }
      @media (width >= 48rem) {
        .intro-case-study_text {
          text-wrap: pretty;
        }
        .intro-case-study_meta {
          flex-direction: row;
          justify-content: space-between;
          gap: var(--site-gutter);
        }
      }
    }

    @keyframes intro-case-study-rise {
      from {
        opacity: 0;
        translate: 0 var(--page-travel);
      }
    }
  }
</style>
