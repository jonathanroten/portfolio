---
import type { HTMLAttributes } from "astro/types";
import type { CaseStudy } from "@/utils/case-studies.ts";
import { uid } from "@/utils/unique-id.ts";

import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import GalleryCaseStudy from "@/components/content/GalleryCaseStudy.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Case studies to feature, as `getCaseStudies` returns them. */
  caseStudies?: CaseStudy[];
}

const { render = true, caseStudies, class: className, ...rest } = Astro.props;

const galleryRows = 5;

const countRows = (gallery: CaseStudy["featureGallery"]) => {
  const rows: CaseStudy["featureGallery"][] = [];
  for (const image of gallery) {
    const lastRow = rows.at(-1);
    const hasRoom = lastRow?.length === 1 && lastRow[0].layout === "default";
    if (image.layout === "default" && hasRoom) lastRow.push(image);
    else rows.push([image]);
  }
  return rows.slice(0, galleryRows).flat();
};

const items = (caseStudies ?? []).map((caseStudy) => ({
  ...caseStudy,
  featureGallery: countRows(caseStudy.featureGallery),
}));

const total = String(items.length).padStart(2, "0");
---

{render && items.length > 0 && (
  <div
    class:list={["feature-case-study_wrap", "width-full", className]}
    role="list"
    {...rest}
  >
    {items.map((caseStudy) => {
      const href = `/case-studies/${caseStudy.slug}/`;
      const number = String(caseStudy.number).padStart(2, "0");
      const titleId = uid("feature-case-study-title");
      const Tag = caseStudy.ready ? "a" : "div";
      const linkAttrs = caseStudy.ready
        ? {
            href,
            "aria-labelledby": caseStudy.title ? titleId : undefined,
          }
        : {};
      return (
        <div class="feature-case-study_item" role="listitem">
          <Tag
            class="feature-case-study_layout"
            data-cursor={`${number}_${total}`}
            data-cursor-state={caseStudy.ready ? undefined : "disabled"}
            {...linkAttrs}
          >
            <div class="feature-case-study_info">
              <div class="feature-case-study_counter text-style-h6">
                <span>{number}</span>
              </div>
              <ContentWrapper>
                {caseStudy.title && (
                  <Heading
                    tag="h2"
                    variant="h3"
                    maxWidth={18}
                    id={titleId}
                    class="text-wrap-pretty"
                    data-cursor={caseStudy.ready ? "" : undefined}
                  >
                    <span class="feature-case-study_title">
                      {caseStudy.title}
                    </span>
                  </Heading>
                )}
                {(caseStudy.services.length || caseStudy.description) && (
                  <div class="feature-case-study_content">
                    {!!caseStudy.services.length && (
                      <>
                        <Heading tag="h3" variant="h5" class="margin-bottom-3">
                          Services Provided
                        </Heading>
                        <ul class="list-inline">
                          {caseStudy.services.map((service) => (
                            <li class="text-style-main">{service}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {caseStudy.description && (
                      <Paragraph
                        variant="h4"
                        maxWidth={40}
                        class="margin-top-7"
                      >
                        {caseStudy.description}
                      </Paragraph>
                    )}
                  </div>
                )}
              </ContentWrapper>
            </div>
            {!!caseStudy.featureGallery.length && (
              <div class="feature-case-study_gallery">
                <GalleryCaseStudy images={caseStudy.featureGallery} />
              </div>
            )}
          </Tag>
          <div class="feature-case-study_action">
            {caseStudy.ready ? (
              <Button element="link" href={href} class="width-full">
                View Study<span class="sr-only">: {caseStudy.title}</span>
              </Button>
            ) : (
              <Button disabled class="width-full">
                Coming Soon
              </Button>
            )}
          </div>
        </div>
      );
    })}
  </div>
)}

<style is:global>
  @layer components {
    .feature-case-study_item {
      column-gap: var(--site-gutter);
      .feature-case-study_layout {
        width: 100%;
        display: flex;
        flex-direction: column;
        column-gap: var(--site-gutter);
      }
      .feature-case-study_info {
        display: flex;
        flex-direction: column;
        padding: var(--space-8) 0 var(--space-6);
      }
      .feature-case-study_title {
        transition: color var(--hover-duration-slow) var(--hover-ease);
      }
      .feature-case-study_gallery {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .feature-case-study_counter {
        border: var(--border-width-medium) solid var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1/1;
        max-width: 3rem;
        border-radius: var(--radius-round);
        line-height: 1;
        margin-bottom: var(--space-6);
      }
      .feature-case-study_action {
        padding-top: var(--gallery-gap);
      }
      @media (hover: hover) and (pointer: fine) {
        a .feature-case-study_title:hover {
          color: var(--text-2);
        }
        .feature-case-study_action {
          display: none;
        }
      }
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        .feature-case-study_layout {
          grid-column: 1 / -1;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        :is(.feature-case-study_info, .feature-case-study_gallery) {
          min-height: var(--full-height);
        }
        .feature-case-study_info {
          justify-content: end;
          align-self: start;
          position: sticky;
          top: var(--nav-total-height);
        }
        .feature-case-study_gallery {
          padding-bottom: var(--gallery-gap);
        }
        .feature-case-study_counter {
          display: none;
        }
        .feature-case-study_action {
          grid-column: 2;
          padding-top: 0;
          padding-bottom: var(--space-3);
        }
      }
    }
  }
</style>
