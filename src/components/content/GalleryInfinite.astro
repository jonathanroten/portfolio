---
import type { HTMLAttributes } from "astro/types";
import type { GalleryImage } from "@/types.ts";
import { imageUrl } from "@/sanity/lib/image.ts";
import { videoPath } from "@/sanity/lib/video.ts";
import type { getGalleryItems } from "@/sanity/lib/queries.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Images to show in the gallery, as `getGalleryItems` returns them. */
  items?: Awaited<ReturnType<typeof getGalleryItems>>;
}

const { render = true, items = [], class: className, ...rest } = Astro.props;

const SIZES: Record<
  (typeof items)[number]["aspectRatio"],
  { ratio: number; width: number; fullWidth: number }
> = {
  "1:1": { ratio: 1, width: 640, fullWidth: 1200 },
  "16:9": { ratio: 16 / 9, width: 1024, fullWidth: 1800 },
  "3:4": { ratio: 3 / 4, width: 768, fullWidth: 1200 },
};

const WIDTHS = [240, 320, 400, 480, 640, 800];

const images: GalleryImage[] = items.map((item) => {
  const { ratio, width, fullWidth } = SIZES[item.aspectRatio];
  return {
    src: imageUrl(item, width, ratio),
    srcset: [...WIDTHS.filter((size) => size < width), width]
      .map((size) => `${imageUrl(item, size, ratio)} ${size}w`)
      .join(", "),
    fullSrc: imageUrl(item, fullWidth, ratio),
    width,
    height: Math.round(width / ratio),
    services: item.services ?? [],
    video: item.video ? videoPath(item.video) : undefined,
  };
});
---

{render && images.length > 0 && (
  <>
    <link rel="preconnect" href={new URL(images[0].src).origin} crossorigin />
    <div
      class:list={["gallery-infinite_wrap", className]}
      data-items={JSON.stringify(images)}
      {...rest}
    >
      <ul class="sr-only">
        {items.map(({ alt }, index) => (
          <li>
            {[alt, images[index].services.join(", ")]
              .filter(Boolean)
              .join(" — ")}
          </li>
        ))}
      </ul>
      <canvas class="gallery-infinite_canvas" aria-hidden="true" />
      <div class="gallery-infinite_focus">
        <video
          class="gallery-infinite_video"
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          disableRemotePlayback
          aria-hidden="true"
        />
        <div class="gallery-infinite_details" aria-live="polite">
          <p class="gallery-infinite_service text-style-small text-transform-uppercase" />
          <p class="gallery-infinite_index text-style-small text-transform-uppercase" />
        </div>
      </div>
    </div>
    <noscript class="gallery-infinite_fallback">
      <ul class="gallery-infinite_fallback_list" role="list">
        {images.map(({ src, width, height }) => (
          <li>
            <img
              class="image"
              src={src}
              width={width}
              height={height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </noscript>
  </>
)}

<script>
  import type { GalleryImage } from "@/types.ts";
  import type { MotionShader } from "@/utils/motion-shader.ts";
  import {
    loadMotionShader,
    onPlainImagesChange,
    prefersPlainImages,
    uploadGap,
  } from "@/utils/motion-shader-loader.ts";

  const config = {
    tileWidth: 1440,
    tileHeight: 1200,
    frames: [
      { x: 60, y: 50, w: 426.667, h: 240 },
      { x: 360, y: 200, w: 240, h: 240 },
      { x: 720, y: 100, w: 480, h: 270 },
      { x: 1140, y: 50, w: 240, h: 240 },
      { x: 0, y: 400, w: 240, h: 320 },
      { x: 600, y: 750, w: 240, h: 240 },
      { x: 780, y: 450, w: 300, h: 400 },
      { x: 60, y: 880, w: 480, h: 270 },
      { x: 1140, y: 830, w: 240, h: 320 },
    ],
    shapes: { wide: 16 / 9, square: 1, tall: 3 / 4 },
    devices: {
      wide: {
        width: 1920,
        height: 1080,
        body: { x: 0, y: 0, w: 1920, h: 1080 },
        screen: { x: 0, y: 56, w: 1920, h: 1024 },
        radius: 0,
      },
      tall: {
        width: 1200,
        height: 1600,
        body: { x: 220, y: 0, w: 760, h: 1600 },
        screen: { x: 240, y: 20, w: 720, h: 1560 },
        radius: 100,
      },
    },
    rowStep: 2,
    tileMinRem: 56,
    tileMaxRem: 100,
    focusRem: 30,
    gapRem: 1.5,
    pushFalloff: 3,
    overscan: 0.1,
    ease: 220,
    glide: 280,
    calmEase: 60,
    keySpeed: 1.1,
    click: { distance: 8, time: 400 },
    revealWait: 3000,
    priorityImages: 2,
    uploadGap,
    motion: {
      smoothing: 50,
      minSpeed: 8,
      maxSpeed: 48,
      attack: 0.3,
      release: 0.1,
      settled: 0.005,
      blur: 120,
      shift: 10,
      lag: 0.5,
      bend: 16,
      leanEase: 120,
    },
  };

  type Shape = keyof typeof config.shapes;

  type Device = typeof config.devices.wide;

  const devices: Partial<Record<Shape, Device>> = config.devices;

  const percent = (part: number, whole: number) => `${(part / whole) * 100}%`;

  const drawReach =
    config.motion.blur * (0.5 + config.motion.lag) +
    config.motion.shift +
    config.motion.bend +
    2;

  const clamp = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(value, max));

  const wrap = (value: number, length: number) =>
    ((value % length) + length) % length;

  const remSize = () =>
    parseFloat(getComputedStyle(document.documentElement).fontSize);

  const afterAnimations = (element: Element) =>
    Promise.allSettled(
      element.getAnimations().map((animation) => animation.finished),
    );

  let corsBlocked = false;

  const loadImage = async (
    image: HTMLImageElement,
    src: string,
    srcset = "",
  ) => {
    if (!corsBlocked) image.crossOrigin = "anonymous";
    image.srcset = srcset;
    image.src = src;
    try {
      await image.decode();
    } catch (error) {
      if (!image.crossOrigin) throw error;
      image.src = src;
      const retried = await image.decode().then(
        () => true,
        () => false,
      );
      if (retried) return;
      image.crossOrigin = null;
      image.src = src;
      await image.decode();
      corsBlocked = true;
    }
  };

  const keyDirections: Partial<Record<string, [number, number]>> = {
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
  };

  const shapeNames = Object.keys(config.shapes) as Shape[];

  const shapeOf = (aspect: number) =>
    shapeNames.reduce((nearest, shape) =>
      Math.abs(Math.log(aspect / config.shapes[shape])) <
      Math.abs(Math.log(aspect / config.shapes[nearest]))
        ? shape
        : nearest,
    );

  const mount = (gallery: HTMLElement, items: GalleryImage[]) => {
    const ids = items.map((_, id) => id);
    const itemShapes = items.map(({ width, height }) =>
      shapeOf(width / height),
    );
    const pools = Object.fromEntries(
      shapeNames.map((shape) => {
        const matching = ids.filter((id) => itemShapes[id] === shape);
        return [shape, matching.length ? matching : ids];
      }),
    ) as Record<Shape, number[]>;

    const counts: Record<Shape, number> = { wide: 0, square: 0, tall: 0 };
    const placements = config.frames.map((frame) => {
      const shape = shapeOf(frame.w / frame.h);
      const rank = counts[shape];
      counts[shape] += 1;
      return {
        shape,
        rank,
        anchor: {
          x: (frame.x + frame.w / 2) / config.tileWidth,
          y: (frame.y + frame.h / 2) / config.tileHeight,
        },
        extent: {
          x: frame.w / 2 / config.tileWidth,
          y: frame.h / 2 / config.tileHeight,
        },
        style: {
          left: `${(frame.x / config.tileWidth) * 100}%`,
          top: `${(frame.y / config.tileHeight) * 100}%`,
          width: `${(frame.w / config.tileWidth) * 100}%`,
          height: `${(frame.h / config.tileHeight) * 100}%`,
        },
      };
    });

    const widest = Object.fromEntries(
      shapeNames.map((shape) => [
        shape,
        Math.max(
          ...placements
            .filter((placement) => placement.shape === shape)
            .map(({ extent }) => extent.x * 2),
        ),
      ]),
    ) as Record<Shape, number>;

    const sizesOf = (shape: Shape) =>
      `${Math.ceil(widest[shape] * tileSize.width)}px`;

    const imageAt = (tx: number, ty: number, shape: Shape, rank: number) => {
      const pool = pools[shape];
      const group = tx + config.rowStep * ty;
      return pool[wrap(group * counts[shape] + rank, pool.length)];
    };

    const tiles = new Map<string, HTMLElement>();
    const center = { x: 0.5, y: 0.5 };
    const target = { x: 0.5, y: 0.5 };
    const drag = {
      id: -1,
      x: 0,
      y: 0,
      time: 0,
      vx: 0,
      vy: 0,
      startX: 0,
      startY: 0,
      startTime: 0,
      moved: false,
      grabbed: false,
      target: null as EventTarget | null,
    };
    const placed = new WeakMap<
      Element,
      {
        anchor: { x: number; y: number };
        extent: { x: number; y: number };
        index: number;
        slot: string;
        shape: Shape;
      }
    >();
    const stacking = new Map<string, number>();
    let stacked = 0;
    const caption = {
      box: gallery.querySelector<HTMLElement>(".gallery-infinite_focus"),
      details: gallery.querySelector<HTMLElement>(".gallery-infinite_details"),
      index: gallery.querySelector<HTMLElement>(".gallery-infinite_index"),
      service: gallery.querySelector<HTMLElement>(".gallery-infinite_service"),
    };
    const video = gallery.querySelector<HTMLVideoElement>(
      ".gallery-infinite_video",
    );
    let focused: HTMLElement | null = null;
    let framed: HTMLElement | null = null;
    let clearing: {
      x: number;
      y: number;
      halfWidth: number;
      halfHeight: number;
    } | null = null;
    const held = new Set<string>();
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    const firstImages: {
      image: HTMLImageElement;
      index: number;
      area: number;
      visible: boolean;
    }[] = [];
    let collecting = true;
    const viewSize = { width: 0, height: 0 };
    const tileSize = { width: 0, height: 0 };

    const label = (image: HTMLElement) => {
      if (focused || !image.classList.contains("is-loaded")) {
        delete image.dataset.cursor;
      } else image.dataset.cursor = "";
    };

    const relabel = () => {
      if (focused) gallery.dataset.cursor = "Close";
      else delete gallery.dataset.cursor;
      for (const tile of tiles.values()) {
        for (const image of tile.children) label(image as HTMLElement);
      }
    };

    const pushOf = (image: Element) => {
      const place = placed.get(image);
      if (!clearing || !place || image === focused) return "";
      const { anchor, extent } = place;
      const dx = (anchor.x - clearing.x) * tileSize.width;
      const dy = (anchor.y - clearing.y) * tileSize.height;
      const distance = Math.hypot(dx, dy);
      if (distance < 1) return "";
      const ux = dx / distance;
      const uy = dy / distance;
      const reach = Math.min(
        (clearing.halfWidth + extent.x * tileSize.width) / Math.abs(ux),
        (clearing.halfHeight + extent.y * tileSize.height) / Math.abs(uy),
      );
      const ratio = distance / reach;
      const k = config.pushFalloff;
      const push = reach * ((ratio ** k + 1) ** (1 / k) - ratio);
      return `${ux * push}px ${uy * push}px`;
    };

    const onScreen = (
      anchor: { x: number; y: number },
      extent: { x: number; y: number },
    ) =>
      Math.abs(anchor.x - center.x) <
        viewSize.width / tileSize.width / 2 + extent.x &&
      Math.abs(anchor.y - center.y) <
        viewSize.height / tileSize.height / 2 + extent.y;

    const syncPush = () => {
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          (image as HTMLElement).style.translate = pushOf(image);
        }
      }
    };

    const show = (image: HTMLImageElement, index: number) => {
      const loaded = loadImage(image, items[index].src, items[index].srcset);
      loaded.then(
        () => {
          image.classList.add("is-loaded");
          label(image);
          if (image.crossOrigin && !sources.has(index)) {
            sources.set(index, image);
            uploadTextures();
          }
        },
        () => {},
      );
      return loaded;
    };

    const createTile = (tx: number, ty: number) => {
      const element = document.createElement("div");
      element.className = "gallery-infinite_tile";
      element.setAttribute("aria-hidden", "true");
      for (const [place, placement] of placements.entries()) {
        const { shape, rank, anchor, extent, style } = placement;
        const image = new Image();
        image.className = "image transparent gallery-infinite_image";
        image.alt = "";
        image.decoding = "async";
        image.draggable = false;
        const index = imageAt(tx, ty, shape, rank);
        const slot = `${tx},${ty},${place}`;
        const position = { x: tx + anchor.x, y: ty + anchor.y };
        placed.set(image, { anchor: position, extent, index, slot, shape });
        image.style.zIndex = String(stacking.get(slot) ?? "");
        image.sizes = sizesOf(shape);
        if (collecting) {
          firstImages.push({
            image,
            index,
            area: extent.x * extent.y,
            visible: onScreen(position, extent),
          });
        } else show(image, index);
        Object.assign(image.style, style);
        image.style.translate = pushOf(image);
        element.append(image);
      }
      return element;
    };

    const syncTiles = () => {
      const left = center.x - viewSize.width / tileSize.width / 2;
      const top = center.y - viewSize.height / tileSize.height / 2;
      const right = left + viewSize.width / tileSize.width;
      const bottom = top + viewSize.height / tileSize.height;
      const wanted = new Set<string>();
      const reach = shader ? drawReach : 0;
      const marginX = config.overscan + reach / tileSize.width;
      const marginY = config.overscan + reach / tileSize.height;
      for (
        let ty = Math.floor(top - marginY);
        ty < Math.ceil(bottom + marginY);
        ty++
      ) {
        for (
          let tx = Math.floor(left - marginX);
          tx < Math.ceil(right + marginX);
          tx++
        ) {
          const key = `${tx},${ty}`;
          wanted.add(key);
          let tile = tiles.get(key);
          if (!tile) {
            tile = createTile(tx, ty);
            tiles.set(key, tile);
            gallery.append(tile);
          }
          tile.style.translate = `${(tx - left) * tileSize.width}px ${(ty - top) * tileSize.height}px`;
        }
      }
      for (const [key, tile] of tiles) {
        if (wanted.has(key)) continue;
        tile.remove();
        tiles.delete(key);
      }
    };

    const syncFocus = () => {
      if (!focused) return;
      const size = getComputedStyle(focused);
      const width = parseFloat(size.width);
      const height = parseFloat(size.height);
      const style = getComputedStyle(gallery);
      const roomWidth =
        viewSize.width -
        2 * parseFloat(style.getPropertyValue("--_focus-inset-inline"));
      const roomHeight =
        viewSize.height -
        2 * parseFloat(style.getPropertyValue("--_focus-inset-block"));
      const scale = Math.max(
        1,
        Math.min(
          (config.focusRem * remSize()) / Math.min(width, height),
          roomWidth / width,
          roomHeight / height,
        ),
      );
      gallery.style.setProperty("--_focus-width", `${width}px`);
      gallery.style.setProperty("--_focus-height", `${height}px`);
      gallery.style.setProperty("--_focus-scale", String(scale));
      const anchor = placed.get(focused)?.anchor;
      if (!anchor) return;
      const captionRoom =
        caption.box && caption.details
          ? caption.details.offsetTop +
            caption.details.offsetHeight -
            caption.box.offsetHeight
          : 0;
      const room = captionRoom + config.gapRem * remSize();
      clearing = {
        x: anchor.x,
        y: anchor.y,
        halfWidth: (width * scale) / 2 + room,
        halfHeight: (height * scale) / 2 + room,
      };
      syncPush();
      followFocus();
    };

    const followFocus = () => {
      const anchor = framed && placed.get(framed)?.anchor;
      if (!anchor || !caption.box) return;
      const x = (anchor.x - center.x) * tileSize.width;
      const y = (anchor.y - center.y) * tileSize.height;
      caption.box.style.translate = `calc(-50% + ${x}px) calc(-50% + ${y}px)`;
    };

    const seat = (image: HTMLElement) => {
      afterAnimations(image).then(() => {
        if (focused !== image) return;
        gallery.classList.add("is-seated");
        if (video?.hasAttribute("src")) video.play().catch(() => {});
      });
    };

    const resize = () => {
      viewSize.width = gallery.clientWidth;
      viewSize.height = gallery.clientHeight;
      if (!viewSize.width || !viewSize.height) return;
      const rem = remSize();
      tileSize.width = clamp(
        viewSize.width,
        config.tileMinRem * rem,
        config.tileMaxRem * rem,
      );
      tileSize.height = (tileSize.width * config.tileHeight) / config.tileWidth;
      gallery.style.setProperty("--_tile-width", `${tileSize.width}px`);
      gallery.style.setProperty("--_tile-height", `${tileSize.height}px`);
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          const shape = placed.get(image)?.shape;
          if (!shape || !(image instanceof HTMLImageElement)) continue;
          const sizes = sizesOf(shape);
          if (image.sizes !== sizes) image.sizes = sizes;
        }
      }
      shader?.resize(viewSize.width, viewSize.height);
      syncFocus();
      syncTiles();
      if (collecting) reveal();
    };

    const canvas = gallery.querySelector<HTMLCanvasElement>(
      ".gallery-infinite_canvas",
    );
    const sources = new Map<number, HTMLImageElement>();
    const lastCenter = { x: 0.5, y: 0.5 };
    const lean = { x: 0, y: 0 };
    const velocity = { x: 0, y: 0 };
    const heading = { x: 0, y: 1 };
    let shader: MotionShader | null = null;
    let shaderRequested = false;
    let uploading = false;
    let drawing = false;
    let strength = 0;

    const uploadTextures = () => {
      if (uploading || !shader) return;
      const active = shader;
      const next = [...sources].find(([index]) => !active.has(index));
      if (!next) return;
      const [index, image] = next;
      uploading = true;
      const source = new Image();
      source.crossOrigin = image.crossOrigin;
      source.src = image.currentSrc;
      source
        .decode()
        .then(
          () => active.upload(index, source),
          () => sources.delete(index),
        )
        .finally(() =>
          setTimeout(() => {
            uploading = false;
            uploadTextures();
          }, config.uploadGap),
        );
    };

    const startShader = () => {
      if (shaderRequested || corsBlocked || !canvas || prefersPlainImages()) {
        return;
      }
      const loading = loadMotionShader(canvas);
      if (!loading) return;
      shaderRequested = true;
      loading
        .then((loaded) => {
          shader = loaded;
          shader.resize(viewSize.width, viewSize.height);
          uploadTextures();
        })
        .catch(console.warn);
    };

    const wallItems = (active: MotionShader) => {
      const left = center.x - viewSize.width / tileSize.width / 2;
      const top = center.y - viewSize.height / tileSize.height / 2;
      const visible = [];
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          const place = placed.get(image);
          if (!place || !image.classList.contains("is-loaded")) continue;
          const width = place.extent.x * 2 * tileSize.width;
          const height = place.extent.y * 2 * tileSize.height;
          const x = (place.anchor.x - left) * tileSize.width - width / 2;
          const y = (place.anchor.y - top) * tileSize.height - height / 2;
          if (
            x + width <= -drawReach ||
            x >= viewSize.width + drawReach ||
            y + height <= -drawReach ||
            y >= viewSize.height + drawReach
          ) {
            continue;
          }
          if (!active.has(place.index)) {
            if (drawing && sources.has(place.index)) continue;
            return null;
          }
          visible.push({
            key: place.index,
            left: x,
            top: y,
            width,
            height,
            order: stacking.get(place.slot) ?? 0,
          });
        }
      }
      return visible.sort((a, b) => a.order - b.order);
    };

    const syncDrawing = (elapsed: number) => {
      const { motion } = config;
      const time = Math.max(elapsed, 1);
      const frames = time / (1000 / 60);
      const blend = 1 - Math.exp(-time / motion.smoothing);
      velocity.x +=
        (((lastCenter.x - center.x) * tileSize.width) / frames - velocity.x) *
        blend;
      velocity.y +=
        (((lastCenter.y - center.y) * tileSize.height) / frames - velocity.y) *
        blend;
      lastCenter.x = center.x;
      lastCenter.y = center.y;
      const speed = Math.hypot(velocity.x, velocity.y);
      if (speed > 1) {
        heading.x = velocity.x / speed;
        heading.y = velocity.y / speed;
      }

      const active = shader;
      const allowed =
        active &&
        !active.isLost() &&
        !focused &&
        !prefersPlainImages() &&
        (drawing || !gallery.getAnimations({ subtree: true }).length);
      if (allowed) {
        const range = clamp(
          (speed - motion.minSpeed) / (motion.maxSpeed - motion.minSpeed),
          0,
          1,
        );
        const goal = range * range * (3 - 2 * range);
        const rate = goal > strength ? motion.attack : motion.release;
        strength += (goal - strength) * (1 - (1 - rate) ** frames);
      } else {
        strength = 0;
      }

      const ready = allowed && strength > motion.settled * (drawing ? 1 : 4);
      const visible = ready ? wallItems(active) : null;
      if (visible && active) {
        const leanBlend = 1 - Math.exp(-time / motion.leanEase);
        lean.x += (heading.x * strength - lean.x) * leanBlend;
        lean.y += (heading.y * strength - lean.y) * leanBlend;
        const leanFade = Math.min(
          1,
          (strength - motion.settled) / (motion.settled * 3),
        );
        const leanX = lean.x * leanFade;
        const leanY = lean.y * leanFade;
        const wallMotion = {
          blurX: heading.x * motion.blur * strength,
          blurY: heading.y * motion.blur * strength,
          shift: motion.shift * (leanX * heading.x + leanY * heading.y),
          lagX: leanX * motion.blur * motion.lag,
          lagY: leanY * motion.blur * motion.lag,
          bendX: leanX * motion.bend,
          bendY: leanY * motion.bend,
        };
        active.draw(visible.map((item) => ({ ...item, motion: wallMotion })));
      } else {
        lean.x = 0;
        lean.y = 0;
        if (ready) strength = 0;
      }
      if (!!visible !== drawing) {
        drawing = !!visible;
        gallery.classList.toggle("is-drawing", drawing);
      }
    };

    let frame = 0;
    let lastTime = 0;

    const step = (now: number) => {
      const elapsed = Math.min(now - lastTime, 50);
      lastTime = now;
      const dragging = drag.id !== -1 && drag.grabbed;
      for (const key of held) {
        const [dx, dy] = keyDirections[key] ?? [0, 0];
        target.x += (dx * config.keySpeed * elapsed) / tileSize.width;
        target.y += (dy * config.keySpeed * elapsed) / tileSize.height;
      }
      const ease = calm.matches ? config.calmEase : config.ease;
      const blend = dragging ? 1 : 1 - Math.exp(-elapsed / ease);
      center.x += (target.x - center.x) * blend;
      center.y += (target.y - center.y) * blend;
      syncTiles();
      followFocus();
      syncDrawing(elapsed);
      gallery.dispatchEvent(new Event("cursor-refresh", { bubbles: true }));
      const pending = Math.hypot(
        (target.x - center.x) * tileSize.width,
        (target.y - center.y) * tileSize.height,
      );
      if (pending < 0.1 && !dragging && !held.size && !drawing) {
        center.x = target.x;
        center.y = target.y;
        frame = 0;
        return;
      }
      frame = requestAnimationFrame(step);
    };

    const start = () => {
      if (frame) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(step);
    };

    const stopVideo = () => {
      if (!video?.hasAttribute("src")) return;
      video.pause();
      video.classList.remove("is-playing");
      video.removeAttribute("src");
      video.load();
    };

    const alignCaption = (device?: Device) => {
      const { width = 1, height = 1 } = device ?? {};
      const { x = 0, y = 0, w = width, h = height } = device?.body ?? {};
      caption.box?.style.setProperty("--_body-left", percent(x, width));
      caption.box?.style.setProperty(
        "--_body-right",
        percent(width - x - w, width),
      );
      caption.box?.style.setProperty(
        "--_body-bottom",
        percent(height - y - h, height),
      );
    };

    const playVideo = (src: string, device: Device) => {
      if (!video || calm.matches) return;
      const { width, height, screen, radius } = device;
      Object.assign(video.style, {
        left: percent(screen.x, width),
        top: percent(screen.y, height),
        width: percent(screen.w, width),
        height: percent(screen.h, height),
        borderRadius: `${percent(radius, screen.w)} / ${percent(radius, screen.h)}`,
      });
      video.src = src;
      video.play().catch(() => {});
      video.pause();
    };

    video?.addEventListener("playing", () => {
      if (video.hasAttribute("src")) video.classList.add("is-playing");
    });

    const unfocus = () => {
      stopVideo();
      const image = focused;
      if (image) {
        image.classList.replace("is-focus", "is-leaving");
        afterAnimations(image).then(() => image.classList.remove("is-leaving"));
        clearing = null;
        syncPush();
      }
      focused = null;
      gallery.classList.remove("is-seated");
      if (image) relabel();
    };

    const focusOn = (image: HTMLImageElement) => {
      const place = placed.get(image);
      if (!place) return;
      const { anchor, index, slot, shape } = place;
      focused = image;
      framed = image;
      relabel();
      const { services, fullSrc, video: src } = items[index];
      const device =
        src && itemShapes[index] === shape ? devices[shape] : undefined;
      for (const animation of caption.box?.getAnimations() ?? []) {
        animation.finish();
      }
      if (caption.index)
        caption.index.textContent = String(index + 1).padStart(2, "0");
      if (caption.service) caption.service.textContent = services.join("\n");
      alignCaption(device);
      syncFocus();
      stacked += 1;
      stacking.set(slot, stacked);
      image.style.zIndex = String(stacked);
      image.classList.add("is-focus");
      if (src && device) playVideo(src, device);
      seat(image);
      if (image.src !== fullSrc) {
        const full = new Image();
        loadImage(full, fullSrc).then(
          () => {
            if (focused !== image || image.src === fullSrc) return;
            image.crossOrigin = full.crossOrigin;
            image.removeAttribute("srcset");
            image.src = fullSrc;
            image.classList.add("is-loaded");
          },
          () => {},
        );
      }
      target.x = anchor.x;
      target.y = anchor.y;
      start();
    };

    const nearestImage = () => {
      let nearest: HTMLImageElement | null = null;
      let nearestDistance = Infinity;
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          const anchor = placed.get(image)?.anchor;
          if (!anchor || !image.classList.contains("is-loaded")) continue;
          const distance = Math.hypot(
            (anchor.x - center.x) * tileSize.width,
            (anchor.y - center.y) * tileSize.height,
          );
          if (distance < nearestDistance) {
            nearest = image as HTMLImageElement;
            nearestDistance = distance;
          }
        }
      }
      return nearest;
    };

    gallery.addEventListener("pointerdown", (event) => {
      if (drag.id !== -1) return;
      if (event.button !== 0) return;
      gallery.setPointerCapture(event.pointerId);
      Object.assign(drag, {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        time: event.timeStamp,
        vx: 0,
        vy: 0,
        startX: event.clientX,
        startY: event.clientY,
        startTime: event.timeStamp,
        moved: false,
        grabbed: !focused,
        target: event.target,
      });
      if (drag.grabbed) {
        target.x = center.x;
        target.y = center.y;
        gallery.dataset.cursorState = "grabbing";
      }
      gallery.classList.add("is-dragging");
      start();
    });

    gallery.addEventListener("pointermove", (event) => {
      if (event.pointerId !== drag.id) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      const elapsed = Math.max(event.timeStamp - drag.time, 1);
      const travelled = Math.hypot(
        event.clientX - drag.startX,
        event.clientY - drag.startY,
      );
      if (!drag.moved && travelled > config.click.distance) {
        drag.moved = true;
        if (!drag.grabbed) {
          drag.grabbed = true;
          target.x = center.x;
          target.y = center.y;
          gallery.dataset.cursorState = "grabbing";
        }
        unfocus();
      }
      drag.vx = drag.vx * 0.8 + (dx / elapsed) * 0.2;
      drag.vy = drag.vy * 0.8 + (dy / elapsed) * 0.2;
      drag.x = event.clientX;
      drag.y = event.clientY;
      drag.time = event.timeStamp;
      if (!drag.grabbed) return;
      target.x -= dx / tileSize.width;
      target.y -= dy / tileSize.height;
      start();
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== drag.id) return;
      drag.id = -1;
      gallery.classList.remove("is-dragging");
      delete gallery.dataset.cursorState;
      const clicked =
        event.type === "pointerup" &&
        !drag.moved &&
        (!!focused || event.timeStamp - drag.startTime < config.click.time);
      if (clicked) {
        const image =
          drag.target instanceof HTMLImageElement &&
          placed.has(drag.target) &&
          drag.target.classList.contains("is-loaded")
            ? drag.target
            : null;
        if (focused) {
          target.x = center.x;
          target.y = center.y;
          unfocus();
        } else if (image) focusOn(image);
      } else if (!calm.matches && event.timeStamp - drag.time < 100) {
        target.x -= (drag.vx * config.glide) / tileSize.width;
        target.y -= (drag.vy * config.glide) / tileSize.height;
      }
      start();
    };
    gallery.addEventListener("pointerup", release);
    gallery.addEventListener("pointercancel", release);

    gallery.addEventListener(
      "wheel",
      (event) => {
        if (event.ctrlKey) return;
        event.preventDefault();
        unfocus();
        const unit = [1, 16, viewSize.height][event.deltaMode];
        target.x += (event.deltaX * unit) / tileSize.width;
        target.y += (event.deltaY * unit) / tileSize.height;
        start();
      },
      { passive: false },
    );

    document.addEventListener("keydown", (event) => {
      if (!gallery.classList.contains("is-revealed")) return;
      if (event.key === "Escape") return unfocus();
      if (
        event.key === "Enter" &&
        !event.repeat &&
        event.target === document.body &&
        !gallery.closest("[inert]")
      ) {
        const image = focused ? null : nearestImage();
        if (image) focusOn(image);
        else unfocus();
        return;
      }
      if (
        !keyDirections[event.key] ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey
      ) {
        return;
      }
      const typing =
        event.target instanceof Element &&
        event.target.closest("input, textarea, select, [contenteditable]");
      if (typing || gallery.closest("[inert]")) return;
      event.preventDefault();
      unfocus();
      held.add(event.key);
      start();
    });
    document.addEventListener("keyup", (event) => {
      held.delete(event.key);
    });
    window.addEventListener("blur", () => held.clear());

    const reveal = () => {
      collecting = false;
      const visible = firstImages
        .filter((first) => first.visible)
        .sort((a, b) => b.area - a.area);
      for (const { image } of visible.slice(0, config.priorityImages)) {
        image.fetchPriority = "high";
      }
      const loads = visible.map(({ image, index }) => show(image, index));
      Promise.race([
        Promise.allSettled(loads),
        new Promise((resolve) => setTimeout(resolve, config.revealWait)),
      ]).then(() => {
        gallery.classList.add("is-revealed");
        for (const { image, index, visible } of firstImages) {
          if (!visible && image.isConnected) show(image, index);
        }
        firstImages.length = 0;
      });
    };

    new ResizeObserver(resize).observe(gallery);
    resize();
    gallery.classList.add("is-ready");

    onPlainImagesChange(startShader);
    if (document.readyState === "complete") startShader();
    else window.addEventListener("load", startShader, { once: true });
  };

  for (const gallery of document.querySelectorAll<HTMLElement>(
    ".gallery-infinite_wrap",
  )) {
    const items: GalleryImage[] = JSON.parse(gallery.dataset.items ?? "[]");
    if (items.length > 0) mount(gallery, items);
  }
</script>

<style is:global>
  @property --_focus-inset-block {
    syntax: "<length>";
    inherits: false;
    initial-value: 0;
  }
  @property --_focus-inset-inline {
    syntax: "<length>";
    inherits: false;
    initial-value: 0;
  }

  @layer components {
    .gallery-infinite_wrap {
      --_leaving: calc(var(--open-duration) * 0.5);
      --_focus-inset-block: var(--nav-total-height);
      --_focus-inset-inline: var(--site-margin);
      position: absolute;
      inset: 0;
      overflow: clip;
      cursor: grab;
      touch-action: none;
      -webkit-user-select: none;
      user-select: none;
      opacity: 0;
      pointer-events: none;
      &.is-revealed {
        opacity: 1;
        pointer-events: auto;
      }
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background-color: var(--backdrop);
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--open-duration-slow) var(--open-ease);
      }
      &:has(.is-focus)::before {
        opacity: 1;
      }
      &:has(.is-focus) .gallery-infinite_image:not(.is-focus) {
        filter: brightness(calc(100% - var(--backdrop-opacity)));
      }
      &:has(.is-focus) .gallery-infinite_image {
        cursor: inherit;
      }
      &.is-dragging,
      &.is-dragging .gallery-infinite_image {
        cursor: grabbing;
      }
    }

    .gallery-infinite_tile {
      position: absolute;
      top: 0;
      left: 0;
      width: var(--_tile-width);
      height: var(--_tile-height);
      will-change: translate;
      &:has(.is-leaving) {
        z-index: 1;
      }
      &:has(.is-focus) {
        z-index: 2;
      }
      .gallery-infinite_wrap.is-drawing & {
        opacity: 0;
      }
    }

    .gallery-infinite_canvas {
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
      visibility: hidden;
      pointer-events: none;
      .gallery-infinite_wrap.is-drawing & {
        visibility: visible;
      }
    }

    .gallery-infinite_image {
      position: absolute;
      opacity: 0;
      transition:
        filter var(--open-duration-slow) var(--open-ease),
        scale var(--open-duration-slower) var(--open-ease),
        translate var(--open-duration-slower) var(--open-ease);
      &.is-loaded {
        opacity: 1;
      }
      &.is-focus {
        scale: var(--_focus-scale);
      }
      @media (hover: hover) {
        &.is-loaded {
          cursor: pointer;
        }
      }
    }

    .gallery-infinite_focus {
      --_body-left: 0%;
      --_body-right: 0%;
      --_body-bottom: 0%;
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 3;
      width: calc(var(--_focus-width) * var(--_focus-scale));
      height: calc(var(--_focus-height) * var(--_focus-scale));
      translate: -50% -50%;
      color: var(--text);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--_leaving) var(--open-ease);
      .gallery-infinite_wrap:has(.is-focus) & {
        opacity: 1;
        transition-duration: var(--open-duration);
        transition-delay: calc(
          var(--open-duration-slower) - var(--open-duration)
        );
      }
    }

    .gallery-infinite_video {
      position: absolute;
      object-fit: cover;
      opacity: 0;
      .gallery-infinite_wrap.is-seated &.is-playing {
        opacity: 1;
        transition: opacity var(--open-duration) var(--open-ease);
      }
    }

    .gallery-infinite_details {
      position: absolute;
      top: calc(100% - var(--_body-bottom));
      inset-inline: var(--_body-left) var(--_body-right);
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }

    .gallery-infinite_service {
      white-space: pre-line;
    }

    .gallery-infinite_index {
      flex: none;
    }

    .gallery-infinite_fallback {
      align-self: stretch;
    }

    .gallery-infinite_fallback_list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: var(--space-4);
      width: 100%;
      padding: var(--section-space-nav-overlap) var(--site-margin)
        var(--site-margin);
      list-style: none;
    }

    :root:has(.gallery-infinite_wrap.is-ready) {
      overflow: hidden;
      overscroll-behavior: none;
    }
  }
</style>
