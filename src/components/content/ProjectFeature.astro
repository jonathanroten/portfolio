---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Feature title. Supports inline markup. */
  heading?: string;
  /** Services shown under the heading. */
  services?: string[];
  /** Body text. Supports inline markup. */
  text?: string;
}

const {
  render = true,
  heading,
  services,
  text,
  class: className,
  ...rest
} = Astro.props;

const hasServices = !!services?.length;
const column2 = await slotContent(Astro.slots, "column2");
const hasContent = !!(heading || hasServices || text || column2);
---

{
  render && hasContent && (
    <div
      class:list={["project-feature_wrap", "width-full", className]}
      role="listitem"
      {...rest}
    >
      <div class="project-feature_layout">
        <div class="project-feature_column">
          <div class="project-feature_counter text-style-h6">
            <span />
          </div>
          <ContentWrapper>
            {heading && (
              <Heading tag="h2" variant="h3" maxWidth={18}>
                <Fragment set:html={heading} />
              </Heading>
            )}
            {(hasServices || text) && (
              <div class="project-feature_content">
                {hasServices && (
                  <>
                    <Heading tag="h3" variant="h5" class="margin-bottom-3">
                      Services Provided
                    </Heading>
                    <ul>
                      {services!.map((service) => (
                        <li class="text-style-main">{service}</li>
                      ))}
                    </ul>
                  </>
                )}
                {text && (
                  <Paragraph variant="h4" maxWidth={40}>
                    <Fragment set:html={text} />
                  </Paragraph>
                )}
              </div>
            )}
          </ContentWrapper>
        </div>
        {column2 && (
          <div class="project-feature_column" slot="column2">
            <Grid xsmall={1} medium={2} class="gap-1">
              <Fragment set:html={column2} />
            </Grid>
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .project-feature_wrap {
      counter-increment: project;
    }
    .project-feature_layout {
      width: 100%;
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .project-feature_column {
      &:has(.project-feature_content) {
        display: flex;
        flex-direction: column;
        padding: var(--space-8) 0 var(--space-6);
      }
      &:not(:has(.project-feature_content)) {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        .grid > .full-width {
          grid-column: 1 / -1;
        }
      }
      .project-feature_counter {
        border: var(--border-width-large) solid var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1/1;
        max-width: 3rem;
        border-radius: var(--radius-round);
        line-height: 1;
        margin-bottom: var(--space-6);

        span::before {
          content: counter(project, decimal-leading-zero);
        }
      }
      @media (width >= 64rem) {
        min-height: calc(
          100svh - (var(--nav-height) + (var(--nav-padding) * 2))
        );
        &:has(.project-feature_content) {
          justify-content: end;
          align-self: start;
          position: sticky;
          top: calc(var(--nav-height) + (var(--nav-padding) * 2));
        }
        &:not(:has(.project-feature_content)) {
          padding-bottom: var(--space-1);
        }
        .project-feature_counter {
          display: none;
        }
      }
    }

    .project-feature_content {
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5ch;
      }
      li:not(:last-child)::after {
        content: ",";
        display: inline;
      }
    }
  }
</style>
