---
import type { HTMLAttributes } from "astro/types";
import Slider from "@/components/interactive/Slider.astro";
import Img from "@/components/media/Img.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

type ImageSource = ImageMetadata | string;

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Slide images, cropped to 16:9. Omit `alt` for decorative images. */
  images?: { src: ImageSource; alt?: string }[];
  /** Project title. Supports inline markup. */
  heading?: string;
  /** Body text. Supports inline markup. */
  text?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
};

const {
  render = true,
  images,
  heading,
  text,
  headingTag = "h4",
  class: className,
  ...rest
} = Astro.props;

const label = heading?.replace(/<[^>]*>/g, "") || "Project images";
---

{
  render && images?.length && (
    <Slider
      label={label}
      align="center"
      loop
      xsmall={1.2}
      large={1.7}
      class:list={["project-slider_wrap", "gap-1", "gap-row-4", className]}
      {...rest}
    >
      {images.map(({ src, alt }) => (
        <Img
          src={src}
          alt={alt}
          width={1920}
          height={1080}
          class="ratio-16-9"
        />
      ))}
      {(heading || text) && (
        <Fragment slot="caption">
          {heading && (
            <Heading tag={headingTag} variant="h6">
              <Fragment set:html={heading} />
            </Heading>
          )}
          {text && (
            <Paragraph>
              <Fragment set:html={text} />
            </Paragraph>
          )}
        </Fragment>
      )}
    </Slider>
  )
}
