---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Select from "@/components/form/Select.astro";
import Choice from "@/components/form/Choice.astro";
import Turnstile from "@/components/form/Turnstile.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const types = ["Messaging", "Branding", "Web", "Other"];
const budgets = ["Under $5k", "$5k–$10k", "$10k–$25k", "$25k+", "Not sure yet"];
const timelines = [
  "As soon as possible",
  "1–3 months",
  "3–6 months",
  "Flexible",
];
---

{render && (
  <div class:list={["contact-modal_wrap", "margin-trim", className]} {...rest}>
    <Heading
      tag="h2"
      class="margin-bottom-4"
      tabindex="-1"
      data-contact-title="Thank you."
    >
      Say Hello.
    </Heading>
    <Paragraph
      variant="main"
      data-contact-intro="I appreciate the note. I’ll be in touch soon."
    >
      Tell me a bit about what you have in mind, or just say hello. I’ll get
      back to you soon.
    </Paragraph>
    <Form
      name="talk"
      action="/api/contact"
      successMessage=""
      errorMessage="Hmmmm… That didn’t work. Please try again, or email hello@jonathanroten.com."
      class="margin-top-5 flex-grow"
    >
      <div class="contact-modal_entries" data-cursor-native>
        <Input variant="first-name" labelHidden required />
        <Input variant="last-name" labelHidden required />
        <Input variant="email" labelHidden required />
        <Input label="Company Website" labelHidden />
        <Textarea
          label="Your Message"
          name="message"
          labelHidden
          required
          maxlength={5000}
        />
        <div class="contact-modal_project">
          <Choice
            label="Start a Project"
            name="project"
            value="yes"
            size="large"
            data-contact-project
          />
          <fieldset class="contact-modal_fields" disabled>
            <Fieldset
              legend="Type"
              hint="(Select all that apply)"
              variant="chips"
              legendStyle="label"
              required
            >
              {types.map((type) => (
                <Choice
                  label={type}
                  name="type"
                  value={type}
                  variant="chip"
                  data-contact-other={type === "Other" || undefined}
                />
              ))}
            </Fieldset>
            <fieldset class="contact-modal_other" disabled>
              <Input label="Specify" name="type-other" labelHidden required />
            </fieldset>
            <Select label="Budget" options={budgets} labelHidden required />
            <Select label="Timeline" options={timelines} labelHidden required />
          </fieldset>
        </div>
        <Turnstile />
      </div>
      <ButtonWrapper marginTop="auto">
        <Button type="submit" size="large" class="width-full">
          Let’s Talk
        </Button>
      </ButtonWrapper>
    </Form>
  </div>
)}

<script>
  for (const contact of document.querySelectorAll<HTMLElement>(
    ".contact-modal_wrap",
  )) {
    const reveals: [string, string][] = [
      ["[data-contact-project]", ".contact-modal_fields"],
      ["[data-contact-other]", ".contact-modal_other"],
    ];

    for (const [toggleSelector, groupSelector] of reveals) {
      const toggle = contact.querySelector<HTMLInputElement>(toggleSelector);
      const group = contact.querySelector<HTMLFieldSetElement>(groupSelector);
      if (!toggle || !group) continue;

      const sync = () => {
        group.disabled = !toggle.checked;
      };

      toggle.addEventListener("change", sync);
      sync();
    }

    const status = contact.querySelector<HTMLElement>(".form_wrap");
    const title = contact.querySelector<HTMLElement>("[data-contact-title]");
    const intro = contact.querySelector<HTMLElement>("[data-contact-intro]");
    if (!status || !title || !intro) continue;

    new MutationObserver(() => {
      if (status.dataset.state !== "sent") return;
      title.textContent = title.dataset.contactTitle ?? "";
      intro.textContent = intro.dataset.contactIntro ?? "";
      title.focus();
    }).observe(status, { attributeFilter: ["data-state"] });
  }
</script>

<style is:global>
  @layer components {
    .contact-modal_wrap {
      display: flex;
      flex-direction: column;
      min-height: calc(100dvh - var(--_close) - var(--_gutter));
      padding-top: var(--space-7);
    }

    .contact-modal_project {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
      margin-block: var(--space-3);
      padding-top: var(--space-3);
      border-top: var(--border-width) solid var(--border);
    }

    .contact-modal_entries,
    .contact-modal_fields,
    .contact-modal_other {
      display: grid;
      align-self: stretch;
      gap: var(--space-3);
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
      &:disabled {
        display: none;
      }
    }
  }
</style>
