---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import FormattedDate from "@/components/utility/FormattedDate.astro";
import LiveClock from "@/components/utility/LiveClock.astro";
import IntroHome from "@/components/content/IntroHome.astro";
import ImageTrail from "@/components/interactive/ImageTrail.astro";
import FeatureCaseStudy from "@/components/content/FeatureCaseStudy.astro";

import { getDescription, getHeroImages, imageUrl } from "@/utils/sanity.ts";
import { getCaseStudies } from "@/utils/case-studies.ts";

const today = new Date();
const caseStudies = await getCaseStudies();
const heroImages = await getHeroImages();
const description = await getDescription();
---

<Layout theme="dark" smoothScroll>
  <Section
    paddingBottom="even"
    containerClass="flex-grow"
    paddingTop="large"
    class="flex-grow full-height"
  >
    <ContentWrapper class="flex-grow justify-content-end zindex-2">
      <Heading tag="h1" class="sr-only">
        Jonathan Roten's Portfolio
      </Heading>
      <IntroHome description={description} data-page-reveal="0" />
      <div
        class="width-full display-inline-flex justify-content-between"
        data-page-reveal="1"
      >
        <span class="text-style-h6">
          <FormattedDate
            date={today}
            format={{ month: "long", day: "2-digit", year: "numeric" }}
          />
        </span>
        <span class="text-style-h6">
          <LiveClock />
        </span>
      </div>
    </ContentWrapper>
    <ImageTrail
      images={heroImages.map((image) => imageUrl(image, 1200, 4 / 5))}
    />
  </Section>
  <Section paddingTop="none" paddingBottom="none">
    <FeatureCaseStudy caseStudies={caseStudies} />
  </Section>
</Layout>
