{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-13",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },

  "vars": {
    "CONTACT_FROM": "form@jonathanroten.com",
  },
  "secrets": {
    "required": ["CONTACT_TO", "TURNSTILE_SECRET_KEY"],
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],

  "preview_urls": false,
  "previews": {},

  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
