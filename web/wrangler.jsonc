{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-13",

  // The built site. Cloudflare serves these files directly; only requests
  // under /api/ run the Worker in `main`.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },

  // The contact form emails CONTACT_TO, which must be a verified Email Routing
  // destination, from CONTACT_FROM on this domain. CONTACT_TO and
  // TURNSTILE_SECRET_KEY are secrets, kept out of the repo: set each once with
  // `npx wrangler secret put <NAME>`, and locally in `.dev.vars`.
  "vars": {
    "CONTACT_FROM": "form@jonathanroten.com",
  },
  // Deploys fail while a required secret is missing. A new Worker can't take
  // `secret put` until it exists, so its first deploy passes them with
  // `npx wrangler deploy --secrets-file <file>`. See the README.
  "secrets": {
    "required": ["CONTACT_TO", "TURNSTILE_SECRET_KEY"],
  },
  "send_email": [{ "name": "EMAIL" }],

  // Add a `routes` entry to serve this on your own domain. Until then it is
  // reachable at https://portfolio.<your-subdomain>.workers.dev.

  "observability": {
    "enabled": true,
  },
}
