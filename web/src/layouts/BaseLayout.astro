---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import FooterMinimal from "@/components/global/FooterMinimal.astro";
import Modal from "@/components/interactive/Modal.astro";
import ContactModal from "@/components/content/ContactModal.astro";
import SmoothScroll from "@/components/utility/SmoothScroll.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
  /**
   * Footer under the page. `minimal` is a slim strip fixed to the bottom for
   * full-bleed pages. `none` ends the page on its last section.
   */
  footer?: "full" | "minimal" | "none";
  /** Text in the right corner of the `minimal` footer. Omit to leave it empty. */
  footerMessage?: string;
  /** Smooth wheel and trackpad scrolling with Lenis. Touch scrolling stays native. */
  smoothScroll?: boolean;
};

const {
  theme = "inherit",
  overlap = false,
  footer = "full",
  footerMessage,
  smoothScroll = false,
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer === "full" && <Footer />}
    {footer === "minimal" && <FooterMinimal message={footerMessage} />}
    <Modal id="talk" label="Say hello" variant="side-panel" class="theme-brand">
      <ContactModal />
    </Modal>
    {smoothScroll && <SmoothScroll />}
  </body>
</html>
