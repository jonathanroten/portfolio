---
import type { HTMLAttributes } from "astro/types";
import { imageUrl, type getProjects } from "@/utils/sanity.ts";

import Slider from "@/components/interactive/Slider.astro";
import Img from "@/components/media/Img.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Project to show, as `getProjects` returns it. */
  project?: Awaited<ReturnType<typeof getProjects>>[number];
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
}

const {
  render = true,
  project,
  headingTag = "h3",
  class: className,
  ...rest
} = Astro.props;

const crop = { width: 1920, ratio: 16 / 9 };

const images = project?.projectGallery ?? [];
const services = project?.services ?? [];
const label = project?.title
  ? `${project.title} project images`
  : "Project images";
---

{
  render && images.length > 0 && (
    <Slider
      label={label}
      align="center"
      loop
      fade
      xsmall={1.2}
      large={1.7}
      class:list={["gap-1", "gap-row-5", className]}
      {...rest}
    >
      {images.map((image) => (
        <Img
          src={imageUrl(image, crop.width, crop.ratio)}
          alt={image.alt}
          variant="full-width"
          width={crop.width}
          height={Math.round(crop.width / crop.ratio)}
        />
      ))}
      {services.length > 0 && (
        <Fragment slot="caption">
          <Heading tag={headingTag} variant="h5" class="margin-bottom-3">
            Services Provided
          </Heading>
          <Paragraph>{services.join(", ")}</Paragraph>
        </Fragment>
      )}
    </Slider>
  )
}
