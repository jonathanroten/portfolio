---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Position in the case study order, shown as `01`.
   *
   * @min 1
   * @int
   */
  number?: number;
  /** Case study title. */
  heading?: string;
  /** The case study description, as Home shows it. */
  description?: string;
  /** Services provided. */
  services?: string[];
  /** How the work was taken on, such as `Freelance`. */
  engagement?: string;
}

const {
  render = true,
  number,
  heading,
  description,
  services,
  engagement,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && heading && (
    <div class:list={["hero-case-study_wrap", className]} {...rest}>
      {number !== undefined && (
        <span class="hero-case-study_number text-style-h5">
          {String(number).padStart(2, "0")}
        </span>
      )}
      <h1 class="hero-case-study_title text-style-h5">{heading}</h1>
      {description && (
        <p class="hero-case-study_text text-style-h4">{description}</p>
      )}
      {(!!services?.length || !!engagement) && (
        <dl class="hero-case-study_meta">
          {!!services?.length && (
            <div>
              <dt class="sr-only">Services Provided</dt>
              <dd class="text-style-main">{services.join(", ")}</dd>
            </div>
          )}
          {engagement && (
            <div>
              <dt class="sr-only">Engagement</dt>
              <dd class="text-style-main">{engagement}</dd>
            </div>
          )}
        </dl>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .hero-case-study_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
      .hero-case-study_title {
        grid-column: 2;
      }
      .hero-case-study_text {
        grid-column: 1 / -1;
        max-width: 50ch;
        margin-top: var(--space-5);
      }
      .hero-case-study_meta {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        margin-top: var(--space-8);
      }
      @media (width >= 48rem) {
        .hero-case-study_text {
          text-wrap: pretty;
        }
        .hero-case-study_meta {
          flex-direction: row;
          justify-content: space-between;
          gap: var(--site-gutter);
        }
      }
    }
  }
</style>
