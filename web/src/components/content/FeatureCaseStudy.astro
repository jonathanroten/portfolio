---
import type { HTMLAttributes } from "astro/types";
import { galleryCrops, imageUrl } from "@/utils/sanity.ts";
import type { CaseStudy } from "@/utils/case-studies.ts";

import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Img from "@/components/media/Img.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Case studies to feature, as `getCaseStudies` returns them. */
  caseStudies?: CaseStudy[];
}

const { render = true, caseStudies, class: className, ...rest } = Astro.props;

const items = (caseStudies ?? []).filter(
  (caseStudy) =>
    caseStudy.title ||
    caseStudy.services.length ||
    caseStudy.description ||
    caseStudy.featureGallery.length,
);
---

{
  render && items.length > 0 && (
    <div
      class:list={["feature-case-study_wrap", "width-full", className]}
      role="list"
      {...rest}
    >
      {items.map((caseStudy, i) => (
        <div class="feature-case-study_item" role="listitem">
          <div class="feature-case-study_layout">
            <div class="feature-case-study_column">
              <div class="feature-case-study_counter text-style-h6">
                <span>{String(i + 1).padStart(2, "0")}</span>
              </div>
              <ContentWrapper>
                {caseStudy.title && (
                  <Heading tag="h2" variant="h3" maxWidth={18}>
                    {caseStudy.title}
                  </Heading>
                )}
                {(caseStudy.services.length || caseStudy.description) && (
                  <div class="feature-case-study_content">
                    {!!caseStudy.services.length && (
                      <>
                        <Heading tag="h3" variant="h5" class="margin-bottom-3">
                          Services Provided
                        </Heading>
                        <ul>
                          {caseStudy.services.map((service) => (
                            <li class="text-style-main">{service}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {caseStudy.description && (
                      <Paragraph
                        variant="h4"
                        maxWidth={40}
                        class="margin-top-7"
                      >
                        {caseStudy.description}
                      </Paragraph>
                    )}
                  </div>
                )}
              </ContentWrapper>
            </div>
            {!!caseStudy.featureGallery.length && (
              <div class="feature-case-study_column">
                <Grid xsmall={1} medium={2} class="gap-1">
                  {caseStudy.featureGallery.map((image) => {
                    const full = image.layout === "fullWidth";
                    const crop = galleryCrops[image.layout];
                    return (
                      <Img
                        src={imageUrl(image, crop.width, crop.ratio)}
                        variant="full-width"
                        width={crop.width}
                        height={Math.round(crop.width / crop.ratio)}
                        alt={image.alt}
                        class={full ? "grid-column-full" : undefined}
                      />
                    );
                  })}
                </Grid>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  )
}

<style is:global>
  @layer components {
    .feature-case-study_layout {
      width: 100%;
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .feature-case-study_column {
      &:has(.feature-case-study_content) {
        display: flex;
        flex-direction: column;
        padding: var(--space-8) 0 var(--space-6);
      }
      &:not(:has(.feature-case-study_content)) {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .feature-case-study_counter {
        border: var(--border-width-medium) solid var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1/1;
        max-width: 3rem;
        border-radius: var(--radius-round);
        line-height: 1;
        margin-bottom: var(--space-6);
      }
      @media (width >= 64rem) {
        min-height: calc(100svh - var(--nav-total-height));
        &:has(.feature-case-study_content) {
          justify-content: end;
          align-self: start;
          position: sticky;
          top: var(--nav-total-height);
        }
        &:not(:has(.feature-case-study_content)) {
          padding-bottom: var(--space-1);
        }
        .feature-case-study_counter {
          display: none;
        }
      }
    }

    .feature-case-study_content {
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.5ch;
        @supports (text-box: trim-both cap alphabetic) {
          row-gap: calc(1lh - 1cap);
        }
      }
      li:not(:last-child)::after {
        content: ",";
        display: inline;
      }
    }
  }
</style>
