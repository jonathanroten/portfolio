---
import type { HTMLAttributes } from "astro/types";
import IntroCaseStudy from "@/components/content/IntroCaseStudy.astro";

interface Props extends HTMLAttributes<"a"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Position of the case study it leads to, shown as `01`.
   *
   * @min 1
   * @int
   */
  number?: number;
  /** Title of the case study it leads to. */
  heading?: string;
  /** The case study description, as Home shows it. */
  description?: string;
  /** Services provided. */
  services?: string[];
  /** How the work was taken on, such as `Freelance`. */
  engagement?: string;
  /** Link destination. */
  href?: string;
}

const {
  render = true,
  number,
  heading,
  description,
  services,
  engagement,
  href,
  class: className,
  ...rest
} = Astro.props;
---

{render && heading && href && (
  <a
    class:list={["next-case-study_wrap", className]}
    href={href}
    rel="next"
    aria-label={`Next: ${heading}`}
    data-cursor="Next"
    data-cursor-arrow="down"
    {...rest}
  >
    <span class="next-case-study_divider" data-view-transition="divider" />
    <IntroCaseStudy
      tag="h2"
      number={number}
      heading={heading}
      description={description}
      services={services}
      engagement={engagement}
    />
    <div
      class="next-case-study_image background-skeleton"
      data-view-transition="image"
    >
      <slot />
      <div class="next-case-study_overlay" />
    </div>
  </a>
)}

<script>
  for (const img of document.querySelectorAll<HTMLImageElement>(
    ".next-case-study_image img",
  )) {
    const warm = () =>
      Object.assign(new Image(), { sizes: "100vw", srcset: img.srcset });
    if (img.complete) warm();
    else img.addEventListener("load", warm, { once: true });
  }
</script>

<style is:global>
  @layer components {
    .next-case-study_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--site-gutter);
      padding-top: var(--space-5);
      position: relative;
      max-height: 60svh;
      overflow: clip;
      .next-case-study_divider {
        position: absolute;
        inset: 0 0 auto;
        border-top: var(--border-width) solid var(--border);
      }
      .next-case-study_image {
        aspect-ratio: 32 / 9;
        min-height: 0;
        position: relative;
        overflow: clip;
      }
      .next-case-study_overlay {
        position: absolute;
        inset: calc(var(--site-gutter) * -1) 0 0;
        background-image: linear-gradient(
          to bottom,
          transparent,
          var(--background)
        );
        transition: opacity var(--hover-duration-gentle) var(--hover-ease);
      }
      &:focus-visible .next-case-study_overlay {
        opacity: 0.6;
      }
      @media (hover: hover) {
        &:hover .next-case-study_overlay {
          opacity: 0.6;
        }
      }
    }
  }
</style>
