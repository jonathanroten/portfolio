---
import type { HTMLAttributes } from "astro/types";
import type { GalleryImage } from "@/types.ts";
import { imageUrl, type getGalleryItems } from "@/utils/sanity.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Images to show in the gallery, as `getGalleryItems` returns them. */
  items?: Awaited<ReturnType<typeof getGalleryItems>>;
}

const { render = true, items = [], class: className, ...rest } = Astro.props;

const SIZES: Record<
  (typeof items)[number]["aspectRatio"],
  { ratio: number; width: number; fullWidth: number }
> = {
  "1:1": { ratio: 1, width: 640, fullWidth: 1200 },
  "16:9": { ratio: 16 / 9, width: 1024, fullWidth: 1800 },
  "3:4": { ratio: 3 / 4, width: 768, fullWidth: 1200 },
};

const images: GalleryImage[] = items.map((item) => {
  const { ratio, width, fullWidth } = SIZES[item.aspectRatio];
  return {
    src: imageUrl(item, width, ratio),
    fullSrc: imageUrl(item, fullWidth, ratio),
    width,
    height: Math.round(width / ratio),
    services: item.services ?? [],
  };
});
---

{render && images.length > 0 && (
  <>
    <div
      class:list={["gallery-infinite_wrap", className]}
      data-items={JSON.stringify(images)}
      {...rest}
    >
      <ul class="sr-only">
        {items.map(({ alt }, index) => (
          <li>
            {[alt, images[index].services.join(", ")]
              .filter(Boolean)
              .join(" — ")}
          </li>
        ))}
      </ul>
      <canvas class="gallery-infinite_canvas" aria-hidden="true" />
      <div class="gallery-infinite_caption">
        <div class="gallery-infinite_details" aria-live="polite">
          <p class="gallery-infinite_service text-style-small text-transform-uppercase" />
          <p class="gallery-infinite_index text-style-small text-transform-uppercase" />
        </div>
      </div>
    </div>
    <noscript class="gallery-infinite_fallback">
      <ul class="gallery-infinite_fallback_list" role="list">
        {images.map(({ src, width, height }) => (
          <li>
            <img
              class="image"
              src={src}
              width={width}
              height={height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </noscript>
  </>
)}

<script>
  import type { GalleryImage } from "@/types.ts";
  import type { MotionShader } from "@/utils/motion-shader.ts";
  import {
    onPlainImagesChange,
    prefersPlainImages,
  } from "@/utils/plain-images.ts";

  const config = {
    tileWidth: 1440,
    tileHeight: 1200,
    frames: [
      { x: 60, y: 50, w: 426.667, h: 240 },
      { x: 360, y: 200, w: 240, h: 240 },
      { x: 720, y: 100, w: 480, h: 270 },
      { x: 1140, y: 50, w: 240, h: 240 },
      { x: 0, y: 400, w: 240, h: 320 },
      { x: 600, y: 750, w: 240, h: 240 },
      { x: 780, y: 450, w: 300, h: 400 },
      { x: 60, y: 880, w: 480, h: 270 },
      { x: 1140, y: 830, w: 240, h: 320 },
    ],
    shapes: { wide: 16 / 9, square: 1, tall: 3 / 4 },
    rowStep: 2,
    tileMinRem: 56,
    tileMaxRem: 100,
    focusRem: 30,
    gapRem: 1.5,
    pushFalloff: 3,
    overscan: 0.1,
    ease: 220,
    glide: 280,
    calmEase: 60,
    keySpeed: 1.1,
    click: { distance: 8, time: 400 },
    seatDistance: 32,
    popDelay: 400,
    handoffSpeed: 0.5,
    handoffHold: 150,
    uploadGap: 32,
  };

  type Shape = keyof typeof config.shapes;

  const clamp = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(value, max));

  const wrap = (value: number, length: number) =>
    ((value % length) + length) % length;

  const remSize = () =>
    parseFloat(getComputedStyle(document.documentElement).fontSize);

  const afterAnimations = (element: Element) =>
    Promise.allSettled(
      element.getAnimations().map((animation) => animation.finished),
    );

  let corsBlocked = false;

  const loadImage = async (image: HTMLImageElement, src: string) => {
    if (!corsBlocked) image.crossOrigin = "anonymous";
    image.src = src;
    try {
      await image.decode();
    } catch (error) {
      if (!image.crossOrigin) throw error;
      corsBlocked = true;
      image.crossOrigin = null;
      image.src = src;
      await image.decode();
    }
  };

  const keyDirections: Partial<Record<string, [number, number]>> = {
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
  };

  const shapeNames = Object.keys(config.shapes) as Shape[];

  const shapeOf = (aspect: number) =>
    shapeNames.reduce((nearest, shape) =>
      Math.abs(Math.log(aspect / config.shapes[shape])) <
      Math.abs(Math.log(aspect / config.shapes[nearest]))
        ? shape
        : nearest,
    );

  const mount = (gallery: HTMLElement, items: GalleryImage[]) => {
    const ids = items.map((_, id) => id);
    const itemShapes = items.map(({ width, height }) =>
      shapeOf(width / height),
    );
    const pools = Object.fromEntries(
      shapeNames.map((shape) => {
        const matching = ids.filter((id) => itemShapes[id] === shape);
        return [shape, matching.length ? matching : ids];
      }),
    ) as Record<Shape, number[]>;

    const counts: Record<Shape, number> = { wide: 0, square: 0, tall: 0 };
    const placements = config.frames.map((frame) => {
      const shape = shapeOf(frame.w / frame.h);
      const rank = counts[shape];
      counts[shape] += 1;
      return {
        shape,
        rank,
        anchor: {
          x: (frame.x + frame.w / 2) / config.tileWidth,
          y: (frame.y + frame.h / 2) / config.tileHeight,
        },
        extent: {
          x: frame.w / 2 / config.tileWidth,
          y: frame.h / 2 / config.tileHeight,
        },
        style: {
          left: `${(frame.x / config.tileWidth) * 100}%`,
          top: `${(frame.y / config.tileHeight) * 100}%`,
          width: `${(frame.w / config.tileWidth) * 100}%`,
          height: `${(frame.h / config.tileHeight) * 100}%`,
        },
      };
    });

    const imageAt = (tx: number, ty: number, shape: Shape, rank: number) => {
      const pool = pools[shape];
      const group = tx + config.rowStep * ty;
      return pool[wrap(group * counts[shape] + rank, pool.length)];
    };

    const tiles = new Map<string, HTMLElement>();
    const center = { x: 0.5, y: 0.5 };
    const target = { x: 0.5, y: 0.5 };
    const drag = {
      id: -1,
      x: 0,
      y: 0,
      time: 0,
      vx: 0,
      vy: 0,
      startX: 0,
      startY: 0,
      startTime: 0,
      moved: false,
      grabbed: false,
      target: null as EventTarget | null,
    };
    const placed = new WeakMap<
      Element,
      {
        anchor: { x: number; y: number };
        extent: { x: number; y: number };
        index: number;
        slot: string;
      }
    >();
    const stacking = new Map<string, number>();
    let stacked = 0;
    const caption = {
      box: gallery.querySelector<HTMLElement>(".gallery-infinite_caption"),
      details: gallery.querySelector<HTMLElement>(".gallery-infinite_details"),
      index: gallery.querySelector<HTMLElement>(".gallery-infinite_index"),
      service: gallery.querySelector<HTMLElement>(".gallery-infinite_service"),
    };
    let focused: HTMLElement | null = null;
    let clearing: {
      x: number;
      y: number;
      halfWidth: number;
      halfHeight: number;
    } | null = null;
    let seated = false;
    const held = new Set<string>();
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    let popDelay = config.popDelay;
    const viewSize = { width: 0, height: 0 };
    const tileSize = { width: 0, height: 0 };
    const canvas = gallery.querySelector<HTMLCanvasElement>(
      ".gallery-infinite_canvas",
    );
    const sources = new Map<number, HTMLImageElement>();
    const lastCenter = { x: 0.5, y: 0.5 };
    let shader: MotionShader | null = null;
    let shaderRequested = false;
    let uploading = false;
    let drawing = false;
    let movedAt = -Infinity;

    const uploadTextures = () => {
      if (uploading || !shader) return;
      const active = shader;
      const next = [...sources].find(([index]) => !active.has(index));
      if (!next) return;
      uploading = true;
      active.upload(...next);
      setTimeout(() => {
        uploading = false;
        uploadTextures();
      }, config.uploadGap);
    };

    const label = (image: HTMLElement) => {
      if (focused || !image.classList.contains("is-loaded")) {
        delete image.dataset.cursor;
      } else image.dataset.cursor = "";
    };

    const relabel = () => {
      if (focused) gallery.dataset.cursor = "Close";
      else delete gallery.dataset.cursor;
      for (const tile of tiles.values()) {
        for (const image of tile.children) label(image as HTMLElement);
      }
    };

    const pushOf = (image: Element) => {
      const place = placed.get(image);
      if (!clearing || !place || image === focused) return "";
      const { anchor, extent } = place;
      const dx = (anchor.x - clearing.x) * tileSize.width;
      const dy = (anchor.y - clearing.y) * tileSize.height;
      const distance = Math.hypot(dx, dy);
      if (distance < 1) return "";
      const ux = dx / distance;
      const uy = dy / distance;
      const reach = Math.min(
        (clearing.halfWidth + extent.x * tileSize.width) / Math.abs(ux),
        (clearing.halfHeight + extent.y * tileSize.height) / Math.abs(uy),
      );
      const ratio = distance / reach;
      const k = config.pushFalloff;
      const push = reach * ((ratio ** k + 1) ** (1 / k) - ratio);
      return `${ux * push}px ${uy * push}px`;
    };

    const syncPush = () => {
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          (image as HTMLElement).style.translate = pushOf(image);
        }
      }
    };

    const createTile = (tx: number, ty: number) => {
      const element = document.createElement("div");
      element.className = "gallery-infinite_tile";
      element.setAttribute("aria-hidden", "true");
      for (const [place, placement] of placements.entries()) {
        const { shape, rank, anchor, extent, style } = placement;
        const image = new Image();
        image.className = "image gallery-infinite_image";
        image.alt = "";
        image.decoding = "async";
        image.draggable = false;
        const index = imageAt(tx, ty, shape, rank);
        const slot = `${tx},${ty},${place}`;
        placed.set(image, {
          anchor: { x: tx + anchor.x, y: ty + anchor.y },
          extent,
          index,
          slot,
        });
        image.style.zIndex = String(stacking.get(slot) ?? "");
        const delay = calm.matches ? 0 : Math.random() * popDelay;
        loadImage(image, items[index].src).then(
          () => {
            setTimeout(() => {
              image.classList.add("is-loaded");
              label(image);
            }, delay);
            if (image.crossOrigin && !sources.has(index)) {
              sources.set(index, image);
              uploadTextures();
            }
          },
          () => {},
        );
        Object.assign(image.style, style);
        image.style.translate = pushOf(image);
        element.append(image);
      }
      return element;
    };

    const syncTiles = () => {
      const left = center.x - viewSize.width / tileSize.width / 2;
      const top = center.y - viewSize.height / tileSize.height / 2;
      const right = left + viewSize.width / tileSize.width;
      const bottom = top + viewSize.height / tileSize.height;
      const wanted = new Set<string>();
      const margin = config.overscan;
      for (
        let ty = Math.floor(top - margin);
        ty < Math.ceil(bottom + margin);
        ty++
      ) {
        for (
          let tx = Math.floor(left - margin);
          tx < Math.ceil(right + margin);
          tx++
        ) {
          const key = `${tx},${ty}`;
          wanted.add(key);
          let tile = tiles.get(key);
          if (!tile) {
            tile = createTile(tx, ty);
            tiles.set(key, tile);
            gallery.append(tile);
          }
          tile.style.translate = `${(tx - left) * tileSize.width}px ${(ty - top) * tileSize.height}px`;
        }
      }
      for (const [key, tile] of tiles) {
        if (wanted.has(key)) continue;
        tile.remove();
        tiles.delete(key);
      }
    };

    const syncFocus = () => {
      if (!focused) return;
      const width = focused.offsetWidth;
      const height = focused.offsetHeight;
      const style = getComputedStyle(gallery);
      const roomWidth =
        viewSize.width -
        2 * parseFloat(style.getPropertyValue("--_focus-inset-inline"));
      const roomHeight =
        viewSize.height -
        2 * parseFloat(style.getPropertyValue("--_focus-inset-block"));
      const scale = Math.max(
        1,
        Math.min(
          (config.focusRem * remSize()) / Math.min(width, height),
          roomWidth / width,
          roomHeight / height,
        ),
      );
      gallery.style.setProperty("--_focus-width", `${width}px`);
      gallery.style.setProperty("--_focus-height", `${height}px`);
      gallery.style.setProperty("--_focus-scale", String(scale));
      const anchor = placed.get(focused)?.anchor;
      if (!anchor) return;
      const captionRoom =
        caption.box && caption.details
          ? caption.details.offsetTop +
            caption.details.offsetHeight -
            caption.box.offsetHeight
          : 0;
      const room = captionRoom + config.gapRem * remSize();
      clearing = {
        x: anchor.x,
        y: anchor.y,
        halfWidth: (width * scale) / 2 + room,
        halfHeight: (height * scale) / 2 + room,
      };
      syncPush();
    };

    const seat = (image: HTMLElement) => {
      seated = true;
      afterAnimations(image).then(() => {
        if (focused === image) gallery.classList.add("is-seated");
      });
    };

    const resize = () => {
      viewSize.width = gallery.clientWidth;
      viewSize.height = gallery.clientHeight;
      if (!viewSize.width || !viewSize.height) return;
      const rem = remSize();
      tileSize.width = clamp(
        viewSize.width,
        config.tileMinRem * rem,
        config.tileMaxRem * rem,
      );
      tileSize.height = (tileSize.width * config.tileHeight) / config.tileWidth;
      gallery.style.setProperty("--_tile-width", `${tileSize.width}px`);
      gallery.style.setProperty("--_tile-height", `${tileSize.height}px`);
      shader?.resize(viewSize.width, viewSize.height);
      syncFocus();
      syncTiles();
    };

    const startShader = () => {
      if (shaderRequested || corsBlocked || !canvas || prefersPlainImages()) {
        return;
      }
      const context = canvas.getContext("webgl2", {
        alpha: true,
        depth: false,
        stencil: false,
        antialias: false,
        failIfMajorPerformanceCaveat: true,
      });
      if (!context) return;
      shaderRequested = true;
      import("@/utils/motion-shader.ts")
        .then(({ createMotionShader }) => {
          shader = createMotionShader(canvas, context);
          shader.resize(viewSize.width, viewSize.height);
          uploadTextures();
        })
        .catch(console.warn);
    };

    const wallItems = (active: MotionShader) => {
      const left = center.x - viewSize.width / tileSize.width / 2;
      const top = center.y - viewSize.height / tileSize.height / 2;
      const items = [];
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          const place = placed.get(image);
          if (!place || !image.classList.contains("is-loaded")) continue;
          const width = place.extent.x * 2 * tileSize.width;
          const height = place.extent.y * 2 * tileSize.height;
          const x = (place.anchor.x - left) * tileSize.width - width / 2;
          const y = (place.anchor.y - top) * tileSize.height - height / 2;
          if (
            x + width <= 0 ||
            x >= viewSize.width ||
            y + height <= 0 ||
            y >= viewSize.height
          ) {
            continue;
          }
          if (!active.has(place.index)) {
            if (drawing && sources.has(place.index)) continue;
            return null;
          }
          items.push({
            key: place.index,
            left: x,
            top: y,
            width,
            height,
            order: stacking.get(place.slot) ?? 0,
          });
        }
      }
      return items.sort((a, b) => a.order - b.order);
    };

    const syncDrawing = (now: number, elapsed: number) => {
      const moved = Math.hypot(
        (center.x - lastCenter.x) * tileSize.width,
        (center.y - lastCenter.y) * tileSize.height,
      );
      lastCenter.x = center.x;
      lastCenter.y = center.y;
      if ((moved * (1000 / 60)) / Math.max(elapsed, 1) > config.handoffSpeed) {
        movedAt = now;
      }
      const active = shader;
      const items =
        active &&
        !active.isLost() &&
        !focused &&
        !prefersPlainImages() &&
        now - movedAt < config.handoffHold &&
        (drawing || !gallery.getAnimations({ subtree: true }).length)
          ? wallItems(active)
          : null;
      if (items) active?.draw(items);
      if (!!items !== drawing) {
        drawing = !!items;
        gallery.classList.toggle("is-drawing", drawing);
      }
    };

    let frame = 0;
    let lastTime = 0;

    const step = (now: number) => {
      const elapsed = Math.min(now - lastTime, 50);
      lastTime = now;
      const dragging = drag.id !== -1 && drag.grabbed;
      for (const key of held) {
        const [dx, dy] = keyDirections[key] ?? [0, 0];
        target.x += (dx * config.keySpeed * elapsed) / tileSize.width;
        target.y += (dy * config.keySpeed * elapsed) / tileSize.height;
      }
      const ease = calm.matches ? config.calmEase : config.ease;
      const blend = dragging ? 1 : 1 - Math.exp(-elapsed / ease);
      center.x += (target.x - center.x) * blend;
      center.y += (target.y - center.y) * blend;
      syncTiles();
      syncDrawing(now, elapsed);
      gallery.dispatchEvent(new Event("scroll"));
      const pending = Math.hypot(
        (target.x - center.x) * tileSize.width,
        (target.y - center.y) * tileSize.height,
      );
      if (focused && !seated && pending < config.seatDistance) seat(focused);
      if (pending < 0.1 && !dragging && !held.size && !drawing) {
        center.x = target.x;
        center.y = target.y;
        frame = 0;
        return;
      }
      frame = requestAnimationFrame(step);
    };

    const start = () => {
      if (frame) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(step);
    };

    const unfocus = () => {
      const image = focused;
      if (image) {
        image.classList.replace("is-focus", "is-leaving");
        afterAnimations(image).then(() => image.classList.remove("is-leaving"));
        clearing = null;
        syncPush();
      }
      focused = null;
      seated = false;
      gallery.classList.remove("is-seated");
      if (image) relabel();
    };

    const focusOn = (image: HTMLImageElement) => {
      const place = placed.get(image);
      if (!place) return;
      const { anchor, index, slot } = place;
      focused = image;
      relabel();
      const { services, fullSrc } = items[index];
      for (const animation of caption.box?.getAnimations() ?? []) {
        animation.finish();
      }
      if (caption.index)
        caption.index.textContent = String(index + 1).padStart(2, "0");
      if (caption.service) caption.service.textContent = services.join("\n");
      syncFocus();
      stacked += 1;
      stacking.set(slot, stacked);
      image.style.zIndex = String(stacked);
      image.classList.add("is-focus");
      if (image.src !== fullSrc) {
        const full = new Image();
        loadImage(full, fullSrc).then(
          () => {
            if (focused !== image || image.src === fullSrc) return;
            image.crossOrigin = full.crossOrigin;
            image.src = fullSrc;
            image.classList.add("is-loaded");
          },
          () => {},
        );
      }
      target.x = anchor.x;
      target.y = anchor.y;
      start();
    };

    const nearestImage = () => {
      let nearest: HTMLImageElement | null = null;
      let nearestDistance = Infinity;
      for (const tile of tiles.values()) {
        for (const image of tile.children) {
          const anchor = placed.get(image)?.anchor;
          if (!anchor || !image.classList.contains("is-loaded")) continue;
          const distance = Math.hypot(
            (anchor.x - center.x) * tileSize.width,
            (anchor.y - center.y) * tileSize.height,
          );
          if (distance < nearestDistance) {
            nearest = image as HTMLImageElement;
            nearestDistance = distance;
          }
        }
      }
      return nearest;
    };

    gallery.addEventListener("pointerdown", (event) => {
      if (drag.id !== -1) return;
      if (event.button !== 0) return;
      gallery.setPointerCapture(event.pointerId);
      Object.assign(drag, {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        time: event.timeStamp,
        vx: 0,
        vy: 0,
        startX: event.clientX,
        startY: event.clientY,
        startTime: event.timeStamp,
        moved: false,
        grabbed: !focused,
        target: event.target,
      });
      if (drag.grabbed) {
        target.x = center.x;
        target.y = center.y;
        gallery.dataset.cursorState = "grabbing";
      }
      gallery.classList.add("is-dragging");
      start();
    });

    gallery.addEventListener("pointermove", (event) => {
      if (event.pointerId !== drag.id) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      const elapsed = Math.max(event.timeStamp - drag.time, 1);
      const travelled = Math.hypot(
        event.clientX - drag.startX,
        event.clientY - drag.startY,
      );
      if (!drag.moved && travelled > config.click.distance) {
        drag.moved = true;
        if (!drag.grabbed) {
          drag.grabbed = true;
          target.x = center.x;
          target.y = center.y;
          gallery.dataset.cursorState = "grabbing";
        }
        unfocus();
      }
      drag.vx = drag.vx * 0.8 + (dx / elapsed) * 0.2;
      drag.vy = drag.vy * 0.8 + (dy / elapsed) * 0.2;
      drag.x = event.clientX;
      drag.y = event.clientY;
      drag.time = event.timeStamp;
      if (!drag.grabbed) return;
      target.x -= dx / tileSize.width;
      target.y -= dy / tileSize.height;
      start();
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== drag.id) return;
      drag.id = -1;
      gallery.classList.remove("is-dragging");
      delete gallery.dataset.cursorState;
      const clicked =
        event.type === "pointerup" &&
        !drag.moved &&
        (!!focused || event.timeStamp - drag.startTime < config.click.time);
      if (clicked) {
        const image =
          drag.target instanceof HTMLImageElement &&
          placed.has(drag.target) &&
          drag.target.classList.contains("is-loaded")
            ? drag.target
            : null;
        if (focused) {
          target.x = center.x;
          target.y = center.y;
          unfocus();
        } else if (image) focusOn(image);
      } else if (!calm.matches && event.timeStamp - drag.time < 100) {
        target.x -= (drag.vx * config.glide) / tileSize.width;
        target.y -= (drag.vy * config.glide) / tileSize.height;
      }
      start();
    };
    gallery.addEventListener("pointerup", release);
    gallery.addEventListener("pointercancel", release);

    gallery.addEventListener(
      "wheel",
      (event) => {
        if (event.ctrlKey) return;
        event.preventDefault();
        unfocus();
        const unit = [1, 16, viewSize.height][event.deltaMode];
        target.x += (event.deltaX * unit) / tileSize.width;
        target.y += (event.deltaY * unit) / tileSize.height;
        start();
      },
      { passive: false },
    );

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") return unfocus();
      if (
        event.key === "Enter" &&
        !event.repeat &&
        event.target === document.body &&
        !gallery.closest("[inert]")
      ) {
        const image = focused ? null : nearestImage();
        if (image) focusOn(image);
        else unfocus();
        return;
      }
      if (
        !keyDirections[event.key] ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey
      ) {
        return;
      }
      const typing =
        event.target instanceof Element &&
        event.target.closest("input, textarea, select, [contenteditable]");
      if (typing || gallery.closest("[inert]")) return;
      event.preventDefault();
      unfocus();
      held.add(event.key);
      start();
    });
    document.addEventListener("keyup", (event) => {
      held.delete(event.key);
    });
    window.addEventListener("blur", () => held.clear());

    new ResizeObserver(resize).observe(gallery);
    resize();
    popDelay = 0;
    gallery.classList.add("is-ready");

    onPlainImagesChange(startShader);
    if (document.readyState === "complete") startShader();
    else window.addEventListener("load", startShader, { once: true });
  };

  for (const gallery of document.querySelectorAll<HTMLElement>(
    ".gallery-infinite_wrap",
  )) {
    const items: GalleryImage[] = JSON.parse(gallery.dataset.items ?? "[]");
    if (items.length > 0) mount(gallery, items);
  }
</script>

