---
import type { HTMLAttributes } from "astro/types";
import { imageUrl, type getProjects } from "@/utils/sanity.ts";

import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Img from "@/components/media/Img.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Projects to feature, as `getProjects` returns them. */
  projects?: Awaited<ReturnType<typeof getProjects>>;
}

const { render = true, projects, class: className, ...rest } = Astro.props;

const crops = {
  half: { width: 960, ratio: 8 / 9 },
  full: { width: 1600, ratio: 16 / 9 },
};

const items = (projects ?? []).filter(
  (project) =>
    project.title ||
    project.services?.length ||
    project.description ||
    project.projectGallery?.length,
);
---

{
  render && items.length > 0 && (
    <div
      class:list={["project-feature_wrap", "width-full", className]}
      role="list"
      {...rest}
    >
      {items.map((project, i) => (
        <div class="project-feature_item" role="listitem">
          <div class="project-feature_layout">
            <div class="project-feature_column">
              <div class="project-feature_counter text-style-h6">
                <span>{String(i + 1).padStart(2, "0")}</span>
              </div>
              <ContentWrapper>
                {project.title && (
                  <Heading tag="h2" variant="h3" maxWidth={18}>
                    {project.title}
                  </Heading>
                )}
                {(project.services?.length || project.description) && (
                  <div class="project-feature_content">
                    {!!project.services?.length && (
                      <>
                        <Heading tag="h3" variant="h5" class="margin-bottom-3">
                          Services Provided
                        </Heading>
                        <ul>
                          {project.services.map((service) => (
                            <li class="text-style-main">{service}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {project.description && (
                      <Paragraph
                        variant="h4"
                        maxWidth={40}
                        class="margin-top-7"
                      >
                        {project.description}
                      </Paragraph>
                    )}
                  </div>
                )}
              </ContentWrapper>
            </div>
            {!!project.projectGallery?.length && (
              <div class="project-feature_column">
                <Grid xsmall={1} medium={2} class="gap-1">
                  {project.projectGallery.map((image) => {
                    const full = image.layout === "fullWidth";
                    const crop = full ? crops.full : crops.half;
                    return (
                      <Img
                        src={imageUrl(image, crop.width, crop.ratio)}
                        variant="full-width"
                        width={crop.width}
                        height={Math.round(crop.width / crop.ratio)}
                        alt={image.alt ?? undefined}
                        class={full ? "grid-column-full" : undefined}
                      />
                    );
                  })}
                </Grid>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  )
}

<style is:global>
  @layer components {
    .project-feature_layout {
      width: 100%;
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .project-feature_column {
      &:has(.project-feature_content) {
        display: flex;
        flex-direction: column;
        padding: var(--space-8) 0 var(--space-6);
      }
      &:not(:has(.project-feature_content)) {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .project-feature_counter {
        border: var(--border-width-medium) solid var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1/1;
        max-width: 3rem;
        border-radius: var(--radius-round);
        line-height: 1;
        margin-bottom: var(--space-6);
      }
      @media (width >= 64rem) {
        min-height: calc(100svh - var(--nav-total-height));
        &:has(.project-feature_content) {
          justify-content: end;
          align-self: start;
          position: sticky;
          top: var(--nav-total-height);
        }
        &:not(:has(.project-feature_content)) {
          padding-bottom: var(--space-1);
        }
        .project-feature_counter {
          display: none;
        }
      }
    }

    .project-feature_content {
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.5ch;
        @supports (text-box: trim-both cap alphabetic) {
          row-gap: calc(1lh - 1cap);
        }
      }
      li:not(:last-child)::after {
        content: ",";
        display: inline;
      }
    }
  }
</style>
