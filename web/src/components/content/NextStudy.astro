---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Position of the study it leads to, shown as `01`.
   *
   * @min 1
   * @int
   */
  number?: number;
  /** Title of the study it leads to. */
  heading?: string;
  /** Link destination. */
  href?: string;
}

const {
  render = true,
  number,
  heading,
  href,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && heading && href && (
    <a
      class:list={["next-study_wrap", className]}
      href={href}
      rel="next"
      {...rest}
    >
      <span class="next-study_label">
        <span class="sr-only">Next</span>
        {number !== undefined && (
          <span class="text-style-h5">{String(number).padStart(2, "0")}</span>
        )}
        <span class="text-style-h5">{heading}</span>
      </span>
      <div class="next-study_image background-skeleton">
        <div class="next-study_fade" />
      </div>
    </a>
  )
}

<style is:global>
  @layer components {
    .next-study_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--site-gutter);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
      .next-study_label {
        display: flex;
        gap: var(--space-4);
      }
      .next-study_image {
        aspect-ratio: 32 / 9;
        position: relative;
      }
      .next-study_fade {
        position: absolute;
        inset: calc(var(--site-gutter) * -1) 0 0;
        background-image: linear-gradient(
          to bottom,
          transparent,
          var(--background)
        );
        transition: opacity var(--hover-duration-gentle) var(--hover-ease);
      }
      &:focus-visible .next-study_fade {
        opacity: 0.6;
      }
      @media (hover: hover) {
        &:hover .next-study_fade {
          opacity: 0.6;
        }
      }
    }
  }
</style>
