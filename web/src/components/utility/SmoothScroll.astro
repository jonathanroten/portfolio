<script>
  import Lenis from "lenis";

  const root = document.documentElement;
  const time = getComputedStyle(root).getPropertyValue(
    "--smooth-scroll-duration",
  );
  const seconds = parseFloat(time) / (time.trim().endsWith("ms") ? 1000 : 1);

  const locked = () =>
    ["hidden", "clip"].includes(getComputedStyle(root).overflowY);

  const lenis = new Lenis({
    autoRaf: true,
    lerp: Math.log(1024) / (60 * seconds),
    allowNestedScroll: true,
    prevent: (node) => node instanceof HTMLDialogElement,
    virtualScroll: () => !locked(),
  });

  for (const type of ["pointerdown", "keydown"]) {
    addEventListener(
      type,
      () => {
        if (lenis.isScrolling === "smooth") {
          lenis.scrollTo(lenis.actualScroll, { immediate: true });
        }
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  @import "lenis/dist/lenis.css" layer(components);

  @layer components {
    html.lenis {
      --scroll-duration: var(--smooth-scroll-duration);
      --scroll-ease: var(--smooth-scroll-ease);
    }
  }
</style>
