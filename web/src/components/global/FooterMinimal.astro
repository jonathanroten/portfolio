---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Text in the right corner. Omit to leave the corner empty. */
  hint?: string;
  /** Shorter `hint` for small screens. Defaults to `hint`. */
  compactHint?: string;
}

const { render = true, hint, compactHint = hint } = Astro.props;

const currentYear = new Date().getFullYear();
---

{render && (
  <footer class="footer-minimal_wrap">
    <div class="footer-minimal_inner">
      <span class="text-style-h6">{`© ${currentYear} ${SITE_NAME}`}</span>
      {hint && (
        <span class="text-style-h6" aria-hidden="true">
          <span class="footer-minimal_compact">{compactHint}</span>
          <span class="footer-minimal_full">{hint}</span>
        </span>
      )}
    </div>
  </footer>
)}

<style is:global>
  @layer components {
    .footer-minimal_wrap {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 10;
      display: flex;
      justify-content: center;
      padding: var(--site-margin);
      color: var(--text);
      pointer-events: none;
    }

    .footer-minimal_inner {
      width: 100%;
      max-width: var(--max-width-full);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-6);
      @media (width >= 48rem) {
        .footer-minimal_compact {
          display: none;
        }
        .footer-minimal_full {
          display: inline;
        }
      }
    }

    .footer-minimal_full {
      display: none;
    }
  }
</style>
