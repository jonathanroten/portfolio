---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Text in the right corner. Omit to leave the corner empty. */
  message?: string;
}

const { render = true, message } = Astro.props;

const currentYear = new Date().getFullYear();
---

{render && (
  <footer class="footer-minimal_wrap">
    <div class="footer-minimal_inner">
      <span class="text-style-h6">{`© ${currentYear} ${SITE_NAME}`}</span>
      {message && (
        <span class="text-style-h6" aria-hidden="true">
          {message}
        </span>
      )}
    </div>
  </footer>
)}

<style is:global>
  @layer components {
    .footer-minimal_wrap {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 10;
      display: flex;
      justify-content: center;
      padding: var(--site-margin);
      color: var(--text);
      pointer-events: none;
    }

    .footer-minimal_inner {
      width: 100%;
      max-width: var(--max-width-full);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-6);
    }
  }
</style>
