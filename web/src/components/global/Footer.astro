---
import Icon from "@/components/media/Icon.astro";
import logo from "@/assets/logo/logo-wordmark.svg";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import FooterItem from "@/components/global/FooterItem.astro";
import webflowCertificate from "@/assets/documents/webflow.pdf";
import javascriptCertificate from "@/assets/documents/javascript.pdf";
import { SITE_NAME } from "@/consts.ts";
import { getServices } from "@/utils/sanity.ts";

const currentYear = new Date().getFullYear();
const services = await getServices();

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <Grid xsmall={1} medium={3} class="gap-row-8">
          <div>
            <Heading tag="h2" variant="h5">
              My Approach
            </Heading>
          </div>
          <div class="footer_intro">
            <Paragraph variant="h4">
              I’m motivated by a genuine love of learning and artistic
              expression. I hope to make a positive impact on the world around
              me, and I work toward that through design. I believe creativity is
              interpersonal and that it’s most fulfilling when recognized as a
              shared experience.
            </Paragraph>
            <ButtonWrapper>
              <Button variant="link" element="link" href="#talk">
                Say Hello
              </Button>
            </ButtonWrapper>
          </div>
        </Grid>
        <Grid xsmall={1} small={2} medium={3} class="gap-row-8" role="list">
          <FooterItem
            heading="Experience"
            variant="list-stacked"
            items={[
              { label: "Elephant In The Room: June 2021 – Present" },
              { label: "Novant Health: Oct 2020 – June 2021" },
              { label: "Airtype Studio: Aug 2014 – Oct 2020" },
              { label: "Woodbine: Jan 2013 – July 2014" },
              { label: "MullenLowe: June 2010 – Aug 2012" },
            ]}
          />
          {services.length > 0 && (
            <FooterItem
              heading="Services"
              variant="list-inline"
              items={services.map((label) => ({ label }))}
            />
          )}
          <FooterItem
            heading="Education"
            variant="default"
            text={
              "Appalachian State University, 2010<br/>BS, Communication<br/>Summa Cum Laude"
            }
          />
          <FooterItem
            heading="Profile"
            variant="list-stacked"
            items={[
              { label: "Favorite Food: Mom's Mac + Cheese" },
              { label: "Childhood Hero: Mugsy Bogues" },
              { label: "Go-To Karaoke: Kiss From A Rose" },
            ]}
          />
          <FooterItem
            heading="Certifications"
            variant="list-stacked"
            items={[
              { label: "Webflow Practitioner", href: webflowCertificate },
              {
                label: "Javascript Masterclass",
                href: javascriptCertificate,
              },
            ]}
          />
          <FooterItem
            heading="Additional Info"
            variant="list-stacked"
            items={[
              {
                label: "Follow Me On Instagram",
                href: "https://www.instagram.com/jonathan.roten",
              },
              { label: `© ${currentYear} Copyright. All Rights Reserved.` },
            ]}
          />
        </Grid>

        <div class="footer_bottom">
          <div class="footer_logo" role="img" aria-label={SITE_NAME}>
            <Icon src={logo} variant="full-width" />
          </div>
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding: var(--section-space-medium) var(--site-margin) var(--site-margin);
      background-color: var(--background);
      color: var(--text);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-full);
      display: flex;
      flex-direction: column;
      gap: var(--section-space-medium);
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      width: 100%;
    }

    .footer_logo {
      display: block;
      width: 100%;
    }

    .footer_intro {
      @media (width >= 48rem) {
        grid-column: auto / span 2;
      }
    }

    :root[data-theme-fade] {
      --_theme-timing: var(--theme-duration) var(--theme-ease);
      transition:
        --background var(--_theme-timing),
        --background-2 var(--_theme-timing),
        --background-3 var(--_theme-timing),
        --text var(--_theme-timing),
        --heading-accent var(--_theme-timing),
        --button-background var(--_theme-timing),
        --button-text var(--_theme-timing),
        --button-background-hover var(--_theme-timing),
        --button-text-hover var(--_theme-timing),
        --button-2-background-hover var(--_theme-timing),
        --button-2-text-hover var(--_theme-timing);
    }

    :root[data-theme-fading] {
      *,
      ::before,
      ::after {
        transition: none !important;
      }
    }
  }

  /* Theme tokens registered so the theme swap can fade */
  @property --background {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --background-2 {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --background-3 {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --text {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --heading-accent {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-background {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-text {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-background-hover {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-text-hover {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-2-background-hover {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
  @property --button-2-text-hover {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }
</style>

<script>
  const root = document.documentElement;
  const logo = document.querySelector<HTMLElement>(".footer_logo");
  const theme = [...root.classList].find((name) => name.startsWith("theme-"));
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  if (logo && theme !== "theme-brand") {
    let reached = false;

    const apply = () => {
      const active = reached && !reduce.matches;
      if (root.classList.contains("theme-brand") === active) return;
      if ("themeFade" in root.dataset && !reduce.matches) {
        root.dataset.themeFading = "";
      }
      if (theme) root.classList.toggle(theme, !active);
      root.classList.toggle("theme-brand", active);
    };

    root.addEventListener("transitionend", (event) => {
      if (event.target === root && event.propertyName === "--background") {
        delete root.dataset.themeFading;
      }
    });

    new IntersectionObserver(([entry]) => {
      reached = entry.isIntersecting || entry.boundingClientRect.top < 0;
      apply();
      if (!("themeFade" in root.dataset)) {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => (root.dataset.themeFade = "")),
        );
      }
    }).observe(logo);

    reduce.addEventListener("change", apply);
  }
</script>
