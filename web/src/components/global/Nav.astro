---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import LiveClock from "@/components/utility/LiveClock.astro";
import logo from "@/assets/logo/logomark-stroke.svg";
import arrow from "@/assets/icons/arrow-full.svg";
import { SITE_NAME } from "@/consts.ts";
import { getDescription, getSiteSettings } from "@/utils/sanity.ts";

const { navigation, socialLinks } = await getSiteSettings();
const description = await getDescription();

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label={SITE_NAME} data-cursor-free>
        <Icon src={logo} variant="full-width" />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <div class="nav_menu_inner">
          <div class="nav_menu_content">
            {navigation.length > 0 && (
              <ul class="nav_links fade-siblings">
                {navigation.map((link) => (
                  <NavLink href={link.href}>{link.label}</NavLink>
                ))}
              </ul>
            )}
            {socialLinks.length > 0 && (
              <ul class="nav_socials">
                {socialLinks.map((social) => (
                  <li>
                    <a
                      class="nav_social"
                      href={social.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon
                        src={arrow}
                        variant="small"
                        class="nav_social_icon"
                      />
                      <span class="text-style-h6">{social.label}</span>
                      <span class="sr-only">{" (opens in new tab)"}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <div class="nav_details margin-trim">
              <Paragraph variant="h6">Hi, I&apos;m Jonathan.</Paragraph>
              <Paragraph variant="h6" maxWidth={60} class="text-wrap-pretty">
                {description.text}
              </Paragraph>
              <div class="nav_meta">
                <span class="text-style-h6">
                  <LiveClock
                    format={{
                      month: "long",
                      day: "2-digit",
                      year: "numeric",
                    }}
                  />
                </span>
                <span class="text-style-h6">
                  <LiveClock />
                </span>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const desktopQuery = window.matchMedia("(width >= 48rem)");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      nav.classList.toggle("theme-brand", open);
      toggle.setAttribute("aria-expanded", String(open));
      for (const el of document.body.children) {
        if (el instanceof HTMLElement && !el.contains(nav)) el.inert = open;
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      padding-block: var(--nav-padding);
      color: var(--text);
      pointer-events: none;
      transition:
        color var(--open-duration) var(--open-ease),
        background-color var(--open-duration) var(--open-ease);
      &.overlap {
        position: fixed;
        inset-inline: 0;
        & ~ main .section.full-height {
          min-height: 100svh;
        }
      }
      &.open {
        background-color: var(--background);
        pointer-events: auto;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-full);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
      height: var(--nav-height);
      @media (width >= 48rem) {
        align-items: start;
      }
    }

    .nav_logo,
    .nav_toggle,
    .nav_menu {
      pointer-events: auto;
    }

    .nav_logo {
      height: inherit;
      display: flex;
      align-items: center;
      > svg {
        height: inherit;
      }
    }

    .nav_toggle {
      --_size: 2.75rem;
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--_size);
      min-height: 100%;
      margin-right: calc((var(--_size) - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width-medium));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width-medium);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
      .nav_wrap.open & {
        &::before {
          transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
        }
        &::after {
          transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
        }
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-total-height));
      overflow: clip;
      background-color: var(--background);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease),
        background-color var(--open-duration) var(--open-ease);
      .nav_wrap.open & {
        grid-template-rows: 1fr;
        visibility: visible;
      }
      @media (width >= 48rem) {
        position: static;
        display: block;
        visibility: visible;
        overflow: visible;
        background-color: transparent;
      }
    }

    .nav_menu_inner {
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
      .nav_wrap.open & {
        opacity: 1;
      }
      @media (width >= 48rem) {
        overflow: visible;
        opacity: 1;
      }
    }

    .nav_menu_content {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - var(--nav-total-height));
      padding: 0 var(--site-margin) var(--site-margin);
      @media (width >= 48rem) {
        min-height: 0;
        padding: 0;
      }
    }

    .nav_links {
      --_fade-color: var(--text);
      display: flex;
      flex-direction: column;
      margin-top: auto;
      padding-top: var(--space-6);
      & > li {
        border-bottom: var(--border-width) solid var(--border);
      }
      @media (width >= 48rem) {
        --_fade-color: var(--text-2);
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        padding-top: 0;
        & > li {
          border-bottom: 0;
        }
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-4);
      @media (width >= 48rem) {
        position: relative;
        padding-block: 0;
        transition: color var(--hover-duration-gentle) var(--hover-ease);
        &[aria-current="page"]::after {
          content: "";
          position: absolute;
          inset-inline: calc(var(--h6) * -0.25);
          top: 50%;
          height: var(--border-width-medium);
          background-color: currentcolor;
          translate: 0 -50%;
        }
      }
    }

    .nav_link_text {
      display: block;
      @media (width >= 48rem) {
        font-family: var(--h6-font-family);
        font-size: var(--h6);
        font-weight: var(--h6-font-weight);
        line-height: var(--h6-line-height);
        letter-spacing: var(--h6-letter-spacing);
        text-transform: var(--h6-text-transform);
        text-wrap: var(--h6-text-wrap);
      }
    }

    .nav_socials {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-block: var(--space-6);
      & > li {
        display: flex;
      }
      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_social {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--h6);
      color: var(--text);
    }

    .nav_social_icon {
      rotate: -45deg;
    }

    .nav_details {
      --h6-line-height: var(--line-height-giant);
      margin-top: auto;
      padding-top: var(--space-6);
      border-top: var(--border-width) solid var(--border);
      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-2);
      padding-top: var(--section-space-large);
    }

    :root:has(.nav_wrap.open) {
      overflow: hidden;
    }
  }
</style>
