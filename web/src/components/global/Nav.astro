---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import logo from "@/assets/logo/logomark-stroke.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <NavLink href="#">Say Hello</NavLink>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const desktopQuery = window.matchMedia("(width >= 48rem)");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      padding-block: var(--nav-padding);
      color: var(--text);
      pointer-events: none;
      transition: background-color var(--open-duration) var(--open-ease);
      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
      &.open {
        background-color: var(--background);
        pointer-events: auto;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-full);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
      height: var(--nav-height);
      @media (width >= 48rem) {
        align-items: start;
      }
    }

    .nav_logo,
    .nav_toggle,
    .nav_menu {
      pointer-events: auto;
    }

    .nav_logo {
      height: inherit;
      display: flex;
      align-items: center;
      transition: opacity var(--hover-duration-gentle) var(--hover-ease);
      > svg {
        height: inherit;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_size: 2.75rem;
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--_size);
      min-height: 100%;
      margin-right: calc((var(--_size) - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration-gentle) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
      .nav_wrap.open & {
        &::before {
          transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
        }
        &::after {
          transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
        }
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
      .nav_wrap.open & {
        grid-template-rows: 1fr;
        visibility: visible;
      }
      @media (width >= 48rem) {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
      }
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
      .nav_wrap.open & {
        opacity: 1;
      }
      @media (width >= 48rem) {
        overflow: visible;
        opacity: 1;
      }
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-family: var(--h6-font-family);
      font-size: var(--h6);
      font-weight: var(--h6-font-weight);
      line-height: var(--h6-line-height);
      letter-spacing: var(--h6-letter-spacing);
      text-transform: var(--h6-text-transform);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
      @media (width >= 48rem) {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-4);
        & > li + li {
          border-top: 0;
        }
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text-2);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration-gentle) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      @media (width >= 48rem) {
        padding-block: 0;
        &[aria-current="page"] {
          text-decoration: underline;
        }
      }
    }
  }
</style>
