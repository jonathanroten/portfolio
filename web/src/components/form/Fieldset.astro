---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"fieldset"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field group label. */
  legend?: string;
  /** Guidance shown after the legend, in its own case. */
  hint?: string;
  /** Field layout. */
  variant?: "stack" | "columns" | "thirds" | "inline" | "chips";
  /** Legend style. */
  legendStyle?: "heading" | "label" | "hidden";
  /** Mark the legend, and require at least one checked box. */
  required?: boolean;
}

const {
  render = true,
  legend,
  hint,
  variant = "stack",
  legendStyle = "heading",
  required = false,
  class: className,
  ...rest
} = Astro.props;

const LEGEND_STYLES: Record<NonNullable<Props["legendStyle"]>, string> = {
  heading: "text-style-h5",
  label: "field-label text-style-small",
  hidden: "sr-only",
};

const content = await slotContent(Astro.slots);
---

{render && legend && content && (
  <fieldset
    class:list={["form-fieldset", variant !== "stack" && variant, className]}
    data-required={required || undefined}
    {...rest}
  >
    <legend
      class:list={[
        "form-fieldset_legend",
        `form-fieldset_legend-${legendStyle}`,
        LEGEND_STYLES[legendStyle],
      ]}
    >
      <span>{legend}</span>
      {hint && <span class="form-fieldset_hint">{hint}</span>}
      {required && (
        <span class="field-star" aria-hidden="true">
          *
        </span>
      )}
    </legend>
    <div class="form-fieldset_fields">
      <Fragment set:html={content} />
    </div>
  </fieldset>
)}

<script>
  for (const group of document.querySelectorAll<HTMLFieldSetElement>(
    ".form-fieldset[data-required]",
  )) {
    const boxes = [
      ...group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
    ];
    if (!boxes.length) continue;

    const check = () => {
      const none = !boxes.some((box) => box.checked);
      boxes[0].setCustomValidity(none ? "Select at least one." : "");
    };

    group.addEventListener("change", check);
    check();
  }
</script>

<style is:global>
  @layer components {
    .form-fieldset {
      width: 100%;
      min-width: 0;
      padding: 0;
      border: 0;
    }

    .form-fieldset_legend {
      padding: 0;
      margin-bottom: var(--space-2);
    }

    .form-fieldset_legend-heading {
      margin-bottom: var(--space-3);
    }

    .form-fieldset_hint {
      text-transform: none;
    }

    .form-fieldset_fields {
      display: grid;
      gap: var(--space-3);

      .form-fieldset.inline & {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3) var(--space-5);
        > * {
          width: auto;
        }
      }

      .form-fieldset.chips & {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
      }

      @media (width >= 48rem) {
        .form-fieldset.columns & {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .form-fieldset.thirds & {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    }
  }
</style>
