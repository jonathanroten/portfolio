---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/slug.ts";

type Base = {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Control label. */
  label?: string;
  /** Submitted value. Defaults to `on`. */
  value?: string;
};

type Kind =
  | {
      /** Input type. */
      type?: "checkbox";
      /** Submitted name. Defaults to the label slug. */
      name?: string;
    }
  | {
      /** Input type. */
      type: "radio";
      /** Shared name for the radio group. */
      name: string;
    };

type Style =
  | {
      /** Control style. */
      variant?: "default" | "toggle";
      /** Control size. */
      size?: "default" | "large";
    }
  | {
      variant: "chip";
      size?: never;
    };

type Settings = {
  /** Start selected. */
  checked?: boolean;
  /** Require a selection. */
  required?: boolean;
};

type Props = Omit<HTMLAttributes<"input">, "type" | "value" | "size"> &
  Base &
  Kind &
  Style &
  Settings;

type AllProps = Omit<HTMLAttributes<"input">, "type" | "value" | "size"> &
  Base & { type?: "checkbox" | "radio"; name?: string } & {
    variant?: "default" | "toggle" | "chip";
    size?: "default" | "large";
  } & Settings;

const {
  render = true,
  label,
  value,
  type = "checkbox",
  name,
  variant = "default",
  size = "default",
  checked = false,
  required = false,
  class: className,
  ...rest
} = Astro.props as AllProps;

const textStyle = size === "large" ? "text-style-main" : "text-style-small";
---

{
  render && label && (
    <label
      class:list={["form-choice", variant !== "default" && variant, className]}
    >
      <input
        class="form-choice_input"
        type={type}
        name={name ?? slug(label)}
        value={value}
        checked={checked || undefined}
        required={required || undefined}
        {...rest}
      />
      <span class="form-choice_mark" aria-hidden="true">
        <span class="form-choice_dot" />
      </span>
      <span class:list={["form-choice_text", textStyle]}>{label}</span>
    </label>
  )
}

<style is:global>
  @layer components {
    .form-choice {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      cursor: pointer;
    }

    .form-choice_input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .form-choice_mark {
      --_mark: transparent;
      --_mark-hover: var(--background-2);
      --_mark-chosen: var(--background-2);
      --_edge: var(--text);
      --_ink: var(--text);

      flex: none;
      display: grid;
      place-items: center;
      width: 1em;
      height: 1em;
      background-color: var(--_mark);
      border: var(--border-width-medium) solid var(--_edge);
      border-radius: 0.25em;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
    }

    .form-choice_dot {
      width: 0.4em;
      height: 0.4em;
      background-color: var(--_ink);
      border-radius: var(--radius-round);
      scale: 0;
      transition: scale var(--hover-duration) var(--hover-ease);
    }

    .form-choice:has(.form-choice_input[type="radio"]) .form-choice_mark {
      border-radius: var(--radius-round);
    }

    .form-choice:has(:checked) {
      & .form-choice_mark {
        background-color: var(--_mark-chosen);
      }
      & .form-choice_dot {
        scale: 1;
      }
    }

    @media (hover: hover) {
      .form-choice:hover .form-choice_input:not(:checked) ~ .form-choice_mark {
        background-color: var(--_mark-hover);
      }
    }

    .form-choice_input:focus-visible ~ .form-choice_mark {
      outline: var(--focus-width) solid var(--text);
      outline-offset: var(--focus-offset);
    }

    /* Toggle */
    .form-choice.toggle {
      & .form-choice_mark {
        --_mark: var(--background-2);
        --_mark-hover: var(--background-3);
        --_mark-chosen: var(--text);
        --_edge: transparent;
        --_ink: var(--background);
        width: 2.75em;
        height: 1.5em;
        border-width: var(--border-width);
        border-radius: var(--radius-round);
        place-items: center start;
        padding: 0.15em;
      }
      & .form-choice_dot {
        display: none;
      }
      & .form-choice_mark::after {
        content: "";
        width: 1.1em;
        height: 1.1em;
        border-radius: var(--radius-round);
        background-color: var(--text);
        transition:
          translate var(--hover-duration) var(--hover-ease),
          background-color var(--hover-duration) var(--hover-ease);
      }
      &:has(:checked) .form-choice_mark::after {
        translate: 1.2em 0;
        background-color: var(--_ink);
      }
    }

    /* Chip */
    .form-choice.chip {
      justify-content: center;
      padding: 0.875em 1.5em;
      text-align: center;
      background-color: var(--background-2);
      border: var(--border-width-medium) solid transparent;
      border-radius: var(--radius-small);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      & .form-choice_mark {
        display: none;
      }
      & .form-choice_text {
        text-transform: uppercase;
      }
      @media (hover: hover) {
        &:hover:not(:has(:checked)) {
          background-color: var(--background-3);
        }
      }
      &:has(:checked) {
        background-color: var(--text);
        color: var(--background);
      }
      &:has(.form-choice_input:focus-visible) {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
    }
  }
</style>
