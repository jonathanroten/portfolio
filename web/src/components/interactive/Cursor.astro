---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div class:list={["cursor_wrap", className]} aria-hidden="true" {...rest}>
      <div class="cursor_dot" />
      <div class="cursor_tag text-style-h6" />
    </div>
  )
}

<script>
  const cursor = document.querySelector<HTMLElement>(".cursor_wrap");
  const dot = cursor?.querySelector<HTMLElement>(".cursor_dot");
  const tag = cursor?.querySelector<HTMLElement>(".cursor_tag");

  if (cursor && dot && tag) {
    const root = document.documentElement;
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const typing =
      "input:not([type=checkbox], [type=radio], [type=range], [type=button], [type=submit], [type=reset], [type=color], [type=file]), textarea, [contenteditable]:not([contenteditable=false])";
    const clickable =
      "a[href], button:not(:disabled), label, summary, select, [role=button]";

    const duration = (token: string) => {
      const time = getComputedStyle(root).getPropertyValue(token).trim();
      return parseFloat(time) * (time.endsWith("ms") ? 1 : 1000);
    };

    const parts = [
      { element: dot, token: "--hover-duration-gentle", x: 0, y: 0 },
      { element: tag, token: "--open-duration-slow", x: 0, y: 0 },
    ].map((part) => ({
      ...part,
      rate: Math.log(1024) / duration(part.token),
    }));
    const point = { x: 0, y: 0 };
    let target: Element | null = null;
    let frame = 0;
    let lastTime = 0;

    const place = () => {
      for (const part of parts) {
        part.element.style.translate = `${part.x}px ${part.y}px`;
      }
    };

    const snap = () => {
      for (const part of parts) {
        part.x = point.x;
        part.y = point.y;
      }
      place();
    };

    const step = (now: number) => {
      const elapsed = Math.min(now - lastTime, 50);
      lastTime = now;
      let moving = false;
      for (const part of parts) {
        const blend = 1 - Math.exp(-part.rate * elapsed);
        part.x += (point.x - part.x) * blend;
        part.y += (point.y - part.y) * blend;
        if (Math.hypot(point.x - part.x, point.y - part.y) > 0.1) {
          moving = true;
        } else {
          part.x = point.x;
          part.y = point.y;
        }
      }
      place();
      frame = moving ? requestAnimationFrame(step) : 0;
    };

    const follow = () => {
      if (reduce.matches) return snap();
      if (frame) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(step);
    };

    const rollOptions: KeyframeAnimationOptions = {
      duration: duration("--hover-duration-gentle"),
      easing: getComputedStyle(root).getPropertyValue("--hover-ease").trim(),
      fill: "forwards",
    };
    let tagLabel = "";
    let current: HTMLElement | null = null;
    let rolls: Animation[] = [];

    const tokens = (label: string) => label.match(/\d|\D+/g) ?? [];

    const makeLine = (text: string) => {
      const line = document.createElement("span");
      line.className = "cursor_line";
      line.textContent = text;
      return line;
    };

    const build = (texts: string[]) => {
      tag.replaceChildren(
        ...texts.map((text) => {
          const slot = document.createElement("span");
          slot.className = "cursor_slot";
          slot.append(makeLine(text));
          return slot;
        }),
      );
    };

    const settle = () => {
      for (const animation of rolls) animation.cancel();
      rolls = [];
      build(tokens(tagLabel));
    };

    const roll = (label: string, up: boolean) => {
      settle();
      let before = tokens(tagLabel);
      let after = tokens(label);
      if (before.length !== after.length) {
        before = [tagLabel];
        after = [label];
        build(before);
      }
      tagLabel = label;
      const [exit, enter] = up ? ["-100%", "100%"] : ["100%", "-100%"];
      [...tag.children].forEach((slot, i) => {
        if (before[i] === after[i]) return;
        const old = slot.firstElementChild as HTMLElement;
        const line = makeLine(after[i]);
        slot.append(line);
        rolls.push(
          slot.animate(
            {
              width: [
                getComputedStyle(old).width,
                getComputedStyle(line).width,
              ],
            },
            rollOptions,
          ),
          old.animate({ translate: ["0 0", `0 ${exit}`] }, rollOptions),
          line.animate({ translate: [`0 ${enter}`, "0 0"] }, rollOptions),
        );
      });
      rolls.at(-1)?.addEventListener("finish", settle);
    };

    const update = () => {
      const state = target?.closest<HTMLElement>("[data-cursor-state]")?.dataset
        .cursorState;
      const grabbing = state === "grabbing";
      const marked = grabbing
        ? null
        : target?.closest<HTMLElement>("[data-cursor]");
      const label = marked?.dataset.cursor ?? "";
      if (marked && label) {
        const shown = cursor.classList.contains("is-labelled");
        tag.classList.toggle("is-shown", shown);
        tag.classList.toggle("is-disabled", state === "disabled");
        const canRoll = shown && !reduce.matches;
        if (canRoll && current && current !== marked) {
          const later =
            current.compareDocumentPosition(marked) &
            Node.DOCUMENT_POSITION_FOLLOWING;
          roll(label, !!later);
        } else if (label !== tagLabel) {
          tagLabel = label;
          settle();
        }
        current = marked;
      }
      cursor.classList.toggle("is-labelled", !!label);
      cursor.classList.toggle(
        "is-grown",
        !state && (!!marked || !!target?.closest(clickable)),
      );
      cursor.classList.toggle("is-grabbing", grabbing);
      cursor.classList.toggle("is-typing", !!target?.closest(typing));
    };

    const host = () => {
      const parent = document.querySelector("dialog[open]") ?? document.body;
      if (cursor.parentElement !== parent) parent.append(cursor);
    };

    const hide = () => {
      cursor.classList.remove("is-visible", "is-labelled");
      current = null;
    };

    const stop = () => {
      hide();
      root.classList.remove("has-cursor");
    };

    addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse" || !fine.matches) return stop();
        if (event.target instanceof HTMLIFrameElement) return hide();
        const shown = cursor.classList.contains("is-visible");
        point.x = event.clientX;
        point.y = event.clientY;
        target = event.target instanceof Element ? event.target : null;
        host();
        root.classList.add("has-cursor");
        cursor.classList.add("is-visible");
        update();
        if (shown) follow();
        else snap();
      },
      { passive: true },
    );

    addEventListener(
      "pointerdown",
      (event) => {
        if (event.pointerType !== "mouse") stop();
        else refresh();
      },
      { passive: true },
    );

    addEventListener("pointerup", () => refresh(), { passive: true });

    let pending = 0;

    const refresh = () => {
      host();
      if (!cursor.classList.contains("is-visible") || pending) return;
      pending = requestAnimationFrame(() => {
        pending = 0;
        target = document.elementFromPoint(point.x, point.y);
        update();
      });
    };

    addEventListener("scroll", refresh, { passive: true, capture: true });
    addEventListener("wheel", refresh, { passive: true });
    addEventListener("click", refresh);
    addEventListener("keydown", refresh);

    document.addEventListener("pointerout", (event) => {
      if (!event.relatedTarget) hide();
    });

    document.addEventListener("pointerover", (event) => {
      if (event.target instanceof HTMLIFrameElement) hide();
    });

    for (const type of ["toggle", "close"]) {
      document.addEventListener(type, refresh, true);
    }

    fine.addEventListener("change", () => {
      if (!fine.matches) stop();
    });
  }
</script>

<style is:global>
  @layer components {
    .cursor_wrap {
      --_dot: 0.625rem;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &.is-visible:not(.is-typing) {
        opacity: 1;
      }
    }

    .cursor_dot {
      position: absolute;
      top: calc(var(--_dot) / -2);
      left: calc(var(--_dot) / -2);
      width: var(--_dot);
      height: var(--_dot);
      border-radius: var(--radius-round);
      background-color: var(--cursor-background);
      transition: scale var(--hover-duration-gentle) var(--hover-ease);
      .cursor_wrap.is-grown & {
        scale: 1.75;
      }
      .cursor_wrap.is-grabbing & {
        scale: 0.75;
      }
    }

    .cursor_tag {
      --_color-duration: 0s;
      position: absolute;
      top: 0;
      left: calc(var(--_dot) * 0.875 + var(--space-2));
      display: flex;
      padding-inline: var(--space-1);
      background-color: color-mix(
        in lab,
        var(--cursor-background) 20%,
        transparent
      );
      color: var(--cursor-text);
      white-space: nowrap;
      transform: translateY(-50%);
      transform-origin: left center;
      scale: 0.9;
      opacity: 0;
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        scale var(--hover-duration-gentle) var(--hover-ease),
        color var(--_color-duration) var(--hover-ease),
        background-color var(--_color-duration) var(--hover-ease);
      .cursor_wrap.is-labelled & {
        scale: 1;
        opacity: 1;
      }
      &.is-shown {
        --_color-duration: var(--hover-duration-gentle);
      }
      &.is-disabled {
        background-color: color-mix(in lab, var(--light-100) 10%, transparent);
        color: color-mix(in lab, var(--light-100) 20%, transparent);
      }
    }

    .cursor_slot {
      display: grid;
      overflow: clip;
      text-box: inherit;
    }

    .cursor_line {
      grid-area: 1 / 1;
      justify-self: start;
      padding-block: var(--space-1);
      white-space: pre;
      text-box: inherit;
    }

    :root.has-cursor,
    :root.has-cursor * {
      cursor: none !important;
    }

    :root.has-cursor
      :is(
        input:not(
          [type="checkbox"],
          [type="radio"],
          [type="range"],
          [type="button"],
          [type="submit"],
          [type="reset"],
          [type="color"],
          [type="file"]
        ),
        textarea,
        [contenteditable]:not([contenteditable="false"])
      ) {
      cursor: text !important;
    }
  }
</style>
