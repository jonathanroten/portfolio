---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div class:list={["cursor_wrap", className]} aria-hidden="true" {...rest}>
      <div class="cursor_corner" />
      <div class="cursor_corner" />
      <div class="cursor_corner" />
      <div class="cursor_corner" />
      <div class="cursor_dot" />
      <div class="cursor_tag text-style-h6" />
    </div>
  )
}

<script>
  const cursor = document.querySelector<HTMLElement>(".cursor_wrap");
  const dot = cursor?.querySelector<HTMLElement>(".cursor_dot");
  const tag = cursor?.querySelector<HTMLElement>(".cursor_tag");
  const corners = cursor?.querySelectorAll<HTMLElement>(".cursor_corner");

  if (cursor && dot && tag && corners) {
    const root = document.documentElement;
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const nativeCursor = "[data-cursor-native], input, textarea";
    const lockable =
      '[data-cursor=""], :is(a[href], button:not(:disabled), summary, [role=button]):not([data-cursor], [data-cursor-free], [aria-current="page"])';
    const axes = ["x", "y", "w", "h", "labelX", "labelY"] as const;

    const duration = (token: string) => {
      const time = getComputedStyle(root).getPropertyValue(token).trim();
      return parseFloat(time) * (time.endsWith("ms") ? 1 : 1000);
    };

    const length = (token: string) => {
      cursor.style.width = `var(${token})`;
      const { width } = cursor.getBoundingClientRect();
      cursor.style.removeProperty("width");
      return width;
    };

    const gentleRate = Math.log(1024) / duration("--hover-duration-gentle");
    const quickRate = Math.log(1024) / duration("--hover-duration");
    const point = { x: 0, y: 0 };
    const reticle = { x: 0, y: 0, w: 0, h: 0, labelX: 0, labelY: 0 };
    let roamSize = 0;
    let lockPadding = 0;
    let labelGap = 0;
    let target: Element | null = null;
    let lock: Element | null = null;
    let pressed = false;
    let frame = 0;
    let lastTime = 0;

    const measure = () => {
      roamSize = length("--space-4");
      lockPadding = length("--space-1");
      labelGap = length("--space-3");
    };

    const range = document.createRange();

    const frameOf = (element: Element) => {
      const box = element.getBoundingClientRect();
      if (!element.matches("h1, h2, h3, h4, h5, h6")) return box;
      range.selectNodeContents(element);
      const { left, width } = range.getBoundingClientRect();
      return { left, width, top: box.top, height: box.height };
    };

    const aim = () => {
      if (!lock?.getClientRects().length) lock = null;
      const shape = lock?.querySelector(":scope > svg:only-child") ?? lock;
      const box = shape && frameOf(shape);
      const squeeze = (half: number) =>
        pressed ? half - Math.min(half * 0.14, lockPadding) : half;
      const x = box ? box.left + box.width / 2 : point.x;
      const y = box ? box.top + box.height / 2 : point.y;
      const w = squeeze(box ? box.width / 2 + lockPadding : roamSize / 2);
      const h = squeeze(box ? box.height / 2 + lockPadding : roamSize / 2);
      const right = x + w + labelGap;
      const fits = right + tag.offsetWidth <= innerWidth;
      const beside = fits ? right : x - w - labelGap - tag.offsetWidth;
      return {
        x,
        y,
        w,
        h,
        labelX: box ? x - w : beside,
        labelY: box ? y - h : y + tag.offsetHeight / 2,
      };
    };

    const place = () => {
      const { x, y, w, h, labelX, labelY } = reticle;
      dot.style.translate = `${point.x}px ${point.y}px`;
      corners.forEach((corner, i) => {
        const across = i === 1 || i === 2 ? w : -w;
        const down = i > 1 ? h : -h;
        corner.style.translate = `${x + across}px ${y + down}px`;
      });
      const left = Math.min(labelX, innerWidth - tag.offsetWidth);
      const bottom = Math.max(labelY, tag.offsetHeight);
      tag.style.translate = `${Math.max(left, 0)}px ${Math.min(bottom, innerHeight)}px`;
    };

    const snap = () => {
      Object.assign(reticle, aim());
      place();
    };

    const step = (now: number) => {
      const elapsed = Math.min(now - lastTime, 50);
      lastTime = now;
      const goal = aim();
      for (const axis of axes) {
        const rate =
          lock || axis === "w" || axis === "h" ? gentleRate : quickRate;
        const blend = 1 - Math.exp(-rate * elapsed);
        reticle[axis] += (goal[axis] - reticle[axis]) * blend;
      }
      place();
      const moving = axes.some(
        (axis) => Math.abs(goal[axis] - reticle[axis]) > 0.1,
      );
      frame = moving ? requestAnimationFrame(step) : 0;
    };

    const follow = () => {
      if (reduce.matches) return snap();
      if (frame) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(step);
    };

    const rollOptions: KeyframeAnimationOptions = {
      duration: duration("--hover-duration-gentle"),
      easing: getComputedStyle(root).getPropertyValue("--hover-ease").trim(),
      fill: "forwards",
    };
    let tagLabel = "";
    let current: HTMLElement | null = null;
    let rolls: Animation[] = [];

    const tokens = (label: string) => label.match(/\d|\D+/g) ?? [];

    const makeLine = (text: string) => {
      const line = document.createElement("span");
      line.className = "cursor_line";
      line.textContent = text;
      return line;
    };

    const build = (texts: string[]) => {
      tag.replaceChildren(
        ...texts.map((text) => {
          const slot = document.createElement("span");
          slot.className = "cursor_slot";
          slot.append(makeLine(text));
          return slot;
        }),
      );
    };

    const settle = () => {
      for (const animation of rolls) animation.cancel();
      rolls = [];
      build(tokens(tagLabel));
    };

    const roll = (label: string, up: boolean) => {
      settle();
      const before = tokens(tagLabel);
      const after = tokens(label);
      tagLabel = label;
      if (before.length !== after.length) return settle();
      const [exit, enter] = up ? ["-100%", "100%"] : ["100%", "-100%"];
      [...tag.children].forEach((slot, i) => {
        if (before[i] === after[i]) return;
        const old = slot.firstElementChild as HTMLElement;
        const line = makeLine(after[i]);
        slot.append(line);
        rolls.push(
          old.animate({ translate: ["0 0", `0 ${exit}`] }, rollOptions),
          line.animate({ translate: [`0 ${enter}`, "0 0"] }, rollOptions),
        );
      });
      rolls.at(-1)?.addEventListener("finish", settle);
    };

    const update = () => {
      const state = target?.closest<HTMLElement>("[data-cursor-state]")?.dataset
        .cursorState;
      const grabbing = state === "grabbing";
      const marked = grabbing
        ? null
        : target?.closest<HTMLElement>('[data-cursor]:not([data-cursor=""])');
      const label = marked?.dataset.cursor ?? "";
      const native = target?.closest(nativeCursor);
      lock = state || native ? null : (target?.closest(lockable) ?? null);
      if (marked && label) {
        const shown = cursor.classList.contains("is-labelled");
        tag.classList.toggle("is-shown", shown);
        tag.classList.toggle("is-disabled", state === "disabled");
        const canRoll = shown && !reduce.matches;
        if (canRoll && current && current !== marked) {
          const later =
            current.compareDocumentPosition(marked) &
            Node.DOCUMENT_POSITION_FOLLOWING;
          roll(label, !!later);
        } else if (label !== tagLabel) {
          tagLabel = label;
          settle();
        }
        current = marked;
      }
      cursor.classList.toggle("is-labelled", !!label);
      cursor.classList.toggle("is-grabbing", grabbing);
      root.classList.toggle("is-native", !!native);
    };

    const host = () => {
      const parent = document.querySelector("dialog[open]") ?? document.body;
      if (cursor.parentElement !== parent) parent.append(cursor);
    };

    const hide = () => {
      cursor.classList.remove("is-visible", "is-labelled");
      current = null;
      lock = null;
      pressed = false;
    };

    const stop = () => {
      hide();
      root.classList.remove("has-cursor");
    };

    addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse" || !fine.matches) return stop();
        if (event.target instanceof HTMLIFrameElement) return hide();
        const shown = cursor.classList.contains("is-visible");
        point.x = event.clientX;
        point.y = event.clientY;
        target = event.target instanceof Element ? event.target : null;
        host();
        root.classList.add("has-cursor");
        cursor.classList.add("is-visible");
        update();
        if (shown) follow();
        else snap();
      },
      { passive: true },
    );

    addEventListener(
      "pointerdown",
      (event) => {
        if (event.pointerType !== "mouse") return stop();
        pressed = event.button === 0;
        refresh();
      },
      { passive: true },
    );

    addEventListener(
      "pointerup",
      () => {
        pressed = false;
        refresh();
      },
      { passive: true },
    );

    measure();
    addEventListener("resize", measure, { passive: true });

    let pending = 0;

    const refresh = () => {
      host();
      if (!cursor.classList.contains("is-visible") || pending) return;
      pending = requestAnimationFrame(() => {
        pending = 0;
        target = document.elementFromPoint(point.x, point.y);
        update();
        follow();
      });
    };

    addEventListener("scroll", refresh, { passive: true, capture: true });
    addEventListener("wheel", refresh, { passive: true });
    addEventListener("click", refresh);
    addEventListener("keydown", refresh);

    document.addEventListener("pointerout", (event) => {
      if (!event.relatedTarget) hide();
    });

    document.addEventListener("pointerover", (event) => {
      if (event.target instanceof HTMLIFrameElement) hide();
    });

    for (const type of ["toggle", "close"]) {
      document.addEventListener(type, refresh, true);
    }

    fine.addEventListener("change", () => {
      if (!fine.matches) stop();
    });
  }
</script>

<style is:global>
  @layer components {
    .cursor_wrap {
      --_dot: 0.25rem;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &.is-visible {
        opacity: 1;
      }
      :root.is-native & {
        opacity: 0;
        transition: none;
      }
    }

    .cursor_corner {
      position: absolute;
      top: 0;
      left: 0;
      width: var(--space-1);
      height: var(--space-1);
      border-top: var(--border-width-medium) solid var(--cursor-background);
      border-left: var(--border-width-medium) solid var(--cursor-background);
      border-top-left-radius: calc(var(--radius-xsmall) / 2);
      transform-origin: 0 0;
      &:nth-child(2) {
        rotate: 90deg;
      }
      &:nth-child(3) {
        rotate: 180deg;
      }
      &:nth-child(4) {
        rotate: 270deg;
      }
    }

    .cursor_dot {
      position: absolute;
      top: calc(var(--_dot) / -2);
      left: calc(var(--_dot) / -2);
      width: var(--_dot);
      height: var(--_dot);
      border-radius: var(--radius-round);
      background-color: var(--cursor-background);
      transition: scale var(--hover-duration-gentle) var(--hover-ease);
      .cursor_wrap.is-grabbing & {
        scale: 0.75;
      }
    }

    .cursor_tag {
      --_color-duration: 0s;
      position: absolute;
      bottom: 100%;
      left: 0;
      display: flex;
      color: var(--cursor-text);
      white-space: nowrap;
      transform-origin: left center;
      scale: 0.9;
      opacity: 0;
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        scale var(--hover-duration-gentle) var(--hover-ease),
        color var(--_color-duration) var(--hover-ease);
      .cursor_wrap.is-labelled & {
        scale: 1;
        opacity: 1;
      }
      &.is-shown {
        --_color-duration: var(--hover-duration-gentle);
      }
      &.is-disabled {
        color: color-mix(in lab, var(--light-100) 20%, transparent);
      }
    }

    .cursor_slot {
      display: grid;
      overflow: clip;
      text-box: inherit;
    }

    .cursor_line {
      grid-area: 1 / 1;
      justify-self: start;
      padding-block: var(--space-2);
      white-space: pre;
      text-box: inherit;
    }

    :root.has-cursor:not(.is-native),
    :root.has-cursor:not(.is-native) * {
      cursor: none !important;
    }
  }
</style>
