---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Image sources, in trail order. */
  images?: ComponentProps<typeof Img>["src"][];
}

const { render = true, images, class: className, ...rest } = Astro.props;
---

{
  render && !!images?.length && (
    <div
      class:list={["image-trail_wrap", className]}
      aria-hidden="true"
      {...rest}
    >
      {images.map((src, i) => (
        <div class="image-trail_item">
          <Img
            src={src}
            loading="eager"
            fetchPriority={i === 0 ? "high" : undefined}
          />
        </div>
      ))}
    </div>
  )
}

<script>
  for (const trail of document.querySelectorAll<HTMLElement>(
    ".image-trail_wrap",
  )) {
    const items = Array.from(
      trail.querySelectorAll<HTMLElement>(":scope > .image-trail_item"),
    );
    if (items.length === 0) continue;

    const scope = trail.closest<HTMLElement>(".section") ?? trail;
    const nav = scope.matches("main > :first-child")
      ? document.querySelector<HTMLElement>(".nav_wrap:not(.overlap)")
      : null;

    const config = { threshold: 32, life: 750, flipMs: 1500 };
    const total = items.length;

    const desktopQuery = window.matchMedia("(width >= 64rem)");
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    const pointer = { x: 0, y: 0 };
    const last = { x: 0, y: 0 };
    const timers = new WeakMap<HTMLElement, number>();
    let index = 0;
    let stackTop = 1;
    let hasMoved = false;
    let flipTimer: number | null = null;
    let frame: number | null = null;
    let mouseHandler: ((event: MouseEvent) => void) | null = null;

    const advance = () => {
      items.forEach((item, i) =>
        item.classList.toggle("is-active", i === index),
      );
      index = (index + 1) % total;
    };

    const showImage = () => {
      const item = items[index];
      const inset =
        parseFloat(
          getComputedStyle(trail).getPropertyValue("--_bounds-inset"),
        ) || 0;
      const bounds = scope.getBoundingClientRect();
      const top = bounds.top - (nav?.offsetHeight ?? 0);
      const halfW = item.offsetWidth / 2;
      const halfH = item.offsetHeight / 2;
      const clamp = (value: number, min: number, max: number) =>
        Math.max(min, Math.min(value, max));
      const x = clamp(
        pointer.x,
        bounds.left + inset + halfW,
        bounds.right - inset - halfW,
      );
      const y = clamp(
        pointer.y,
        top + inset + halfH,
        bounds.bottom - inset - halfH,
      );
      const rect = trail.getBoundingClientRect();
      const offsetX = x - (rect.left + rect.width / 2);
      const offsetY = y - (rect.top + rect.height / 2);
      item.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      item.style.zIndex = String(stackTop);
      stackTop += 1;
      item.classList.add("is-active");
      const existing = timers.get(item);
      if (existing) window.clearTimeout(existing);
      timers.set(
        item,
        window.setTimeout(
          () => item.classList.remove("is-active"),
          config.life,
        ),
      );
      index = (index + 1) % total;
    };

    const render = () => {
      if (hasMoved) {
        const distance = Math.hypot(pointer.x - last.x, pointer.y - last.y);
        if (distance > config.threshold) {
          showImage();
          last.x = pointer.x;
          last.y = pointer.y;
        }
      }
      frame = window.requestAnimationFrame(render);
    };

    const teardown = () => {
      if (frame) {
        window.cancelAnimationFrame(frame);
        frame = null;
      }
      if (flipTimer) {
        window.clearInterval(flipTimer);
        flipTimer = null;
      }
      if (mouseHandler) {
        scope.removeEventListener("mousemove", mouseHandler);
        mouseHandler = null;
      }
      items.forEach((item) => {
        const existing = timers.get(item);
        if (existing) window.clearTimeout(existing);
        item.classList.remove("is-active");
        item.style.transform = "";
        item.style.zIndex = "";
      });
      index = 0;
      stackTop = 1;
      hasMoved = false;
    };

    const run = (flipbook: boolean) => {
      teardown();
      if (flipbook) {
        advance();
        if (!reducedMotionQuery.matches) {
          flipTimer = window.setInterval(advance, config.flipMs);
        }
        return;
      }
      mouseHandler = (event) => {
        pointer.x = event.clientX;
        pointer.y = event.clientY;
        if (!hasMoved) {
          last.x = pointer.x;
          last.y = pointer.y;
          hasMoved = true;
        }
      };
      scope.addEventListener("mousemove", mouseHandler);
      frame = window.requestAnimationFrame(render);
    };

    let currentFlip: boolean | null = null;
    const applyMode = () => {
      const flipbook = !desktopQuery.matches;
      if (flipbook === currentFlip) return;
      currentFlip = flipbook;
      run(flipbook);
    };

    let settleTimer: number | null = null;
    const scheduleApply = () => {
      if (settleTimer) window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(applyMode, 120);
    };

    desktopQuery.addEventListener("change", scheduleApply);
    window.addEventListener("resize", scheduleApply);
    reducedMotionQuery.addEventListener("change", () => {
      if (currentFlip !== null) run(currentFlip);
    });
    scheduleApply();
  }
</script>

<style is:global>
  @property --_bounds-inset {
    syntax: "<length>";
    inherits: false;
    initial-value: 0;
  }

  @layer components {
    .image-trail_wrap {
      --_img-width: 18.75rem;
      --_img-ratio: 4/5;
      --_bounds-inset: var(--site-margin);
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;

      .image-trail_item {
        opacity: 0;
        width: var(--_img-width);
        will-change: transform, opacity;
        aspect-ratio: var(--_img-ratio);
        position: absolute;

        &.is-active {
          opacity: 1;
        }
      }

      @media (width < 64rem) {
        --_img-width: 68vw;
        position: relative;
        aspect-ratio: var(--_img-ratio);
        width: 100%;
      }
    }
  }
</style>
