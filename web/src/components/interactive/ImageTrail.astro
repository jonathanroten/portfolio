---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";
import Button from "@/components/Button.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Image sources, in trail order. */
  images?: ComponentProps<typeof Img>["src"][];
}

const { render = true, images, class: className, ...rest } = Astro.props;

const trailQuery = "(width >= 64rem) and (hover: hover) and (pointer: fine)";

const sizes = [
  `${trailQuery} 18.75rem`,
  "(width < 48rem) 68vw",
  "(height < 30rem) and (hover: none) 68vh",
  "47vh",
].join(", ");
---

{render && !!images?.length && (
  <div
    class:list={["image-trail_wrap", className]}
    data-trail-query={trailQuery}
    {...rest}
  >
    <canvas class="image-trail_canvas" aria-hidden="true" />
    {images.map((src, i) => (
      <div class="image-trail_item" aria-hidden="true">
        <Img
          src={src}
          variant="constrained"
          sizes={sizes}
          loading="eager"
          fetchPriority={i === 0 ? "high" : undefined}
        />
      </div>
    ))}
    <div class="image-trail_controls text-style-h6">
      <Button
        variant="play"
        emphasis="tertiary"
        label="Play slideshow"
        pressed={true}
        class="pointer-on"
        data-trail-toggle
      />
    </div>
  </div>
)}

<script>
  import type { MotionShader } from "@/utils/motion-shader.ts";

  const clamp = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(value, max));

  for (const trail of document.querySelectorAll<HTMLElement>(
    ".image-trail_wrap",
  )) {
    const items = Array.from(
      trail.querySelectorAll<HTMLElement>(":scope > .image-trail_item"),
    );
    if (items.length === 0) continue;

    const scope = trail.closest<HTMLElement>(".section") ?? trail;
    const nav = scope.matches("main > :first-child")
      ? document.querySelector<HTMLElement>(".nav_wrap:not(.overlap)")
      : null;

    const config = {
      threshold: 24,
      life: 750,
      flipMs: 1500,
      uploadGap: 32,
      motion: {
        smoothing: 50,
        pause: 100,
        minSpeed: 16,
        maxSpeed: 48,
        attack: 0.3,
        release: 0.1,
        fadeMoving: 0.04,
        fadeResting: 0.25,
        settled: 0.005,
        blur: 32,
        shift: 4,
        lag: 0.5,
        bend: 28,
        drift: 0.3,
        driftSmoothing: 150,
        friction: 0.1,
      },
    };
    const total = items.length;

    const trailQuery = window.matchMedia(trail.dataset.trailQuery ?? "not all");
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const plainQueries = [
      reducedMotionQuery,
      window.matchMedia("(prefers-contrast: more)"),
      window.matchMedia("(forced-colors: active)"),
    ];
    const prefersPlainImages = () =>
      plainQueries.some((query) => query.matches);

    const pointer = { x: 0, y: 0 };
    const last = { x: 0, y: 0 };
    const lastPointer = { x: 0, y: 0 };
    const timers = new WeakMap<HTMLElement, number>();
    let index = 0;
    let stackTop = 1;
    let hasMoved = false;
    let flipTimer: number | null = null;
    let frame: number | null = null;
    let mouseHandler: ((event: MouseEvent) => void) | null = null;

    const canvas = trail.querySelector<HTMLCanvasElement>(
      ":scope > .image-trail_canvas",
    );
    const toggle = trail.querySelector<HTMLButtonElement>(
      "[data-trail-toggle]",
    );
    let playing = !reducedMotionQuery.matches;
    const images = items.map((item) => item.querySelector("img"));
    const places = items.map(() => ({ x: 0, y: 0, order: 0 }));
    const launches = items.map(() => ({ x: 0, y: 1, strength: 0 }));
    const drifts = items.map(() => ({ x: 0, y: 0 }));
    const room = { left: 0, right: 0, top: 0, bottom: 0 };
    const view = { left: 0, top: 0, width: 0, height: 0 };
    const origin = { x: 0, y: 0 };
    const itemSize = { width: 0, height: 0 };
    const travel = { x: 0, y: 0 };
    const velocity = { x: 0, y: 0 };
    const driftVelocity = { x: 0, y: 0 };
    const heading = { x: 0, y: 1 };
    let moveTime = -Infinity;
    let lastTime = 0;
    let shader: MotionShader | null = null;
    let shaderRequested = false;
    let drawing = false;
    let strength = 0;

    const measure = () => {
      const area = scope.getBoundingClientRect();
      const box = trail.getBoundingClientRect();
      const lift = nav?.offsetHeight ?? 0;
      const inset =
        parseFloat(
          getComputedStyle(trail).getPropertyValue("--_bounds-inset"),
        ) || 0;
      view.left = area.left - box.left;
      view.top = area.top - lift - box.top;
      view.width = area.width;
      view.height = area.height + lift;
      origin.x = box.width / 2 - view.left;
      origin.y = box.height / 2 - view.top;
      const size = items[0].getBoundingClientRect();
      itemSize.width = size.width;
      itemSize.height = size.height;
      const centerX = box.left + box.width / 2;
      const centerY = box.top + box.height / 2;
      room.left = area.left + inset + size.width / 2 - centerX;
      room.right = area.right - inset - size.width / 2 - centerX;
      room.top = area.top - lift + inset + size.height / 2 - centerY;
      room.bottom = area.bottom - inset - size.height / 2 - centerY;
      trail.style.setProperty(
        "--_center-offset",
        `${(area.top - lift + area.bottom) / 2 - centerY}px`,
      );
      if (canvas) {
        Object.assign(canvas.style, {
          left: `${view.left}px`,
          top: `${view.top}px`,
          width: `${view.width}px`,
          height: `${view.height}px`,
        });
      }
      shader?.resize(view.width, view.height);
    };

    const uploadTextures = async (active: MotionShader) => {
      for (const [key, image] of images.entries()) {
        if (!image) continue;
        const source = new Image();
        try {
          await image.decode();
          source.src = image.currentSrc;
          await source.decode();
        } catch {
          continue;
        }
        active.upload(key, source);
        await new Promise((done) => setTimeout(done, config.uploadGap));
      }
    };

    const startShader = () => {
      if (
        shaderRequested ||
        !canvas ||
        document.readyState !== "complete" ||
        !trailQuery.matches ||
        prefersPlainImages()
      ) {
        return;
      }
      const context = canvas.getContext("webgl2", {
        depth: false,
        antialias: false,
        failIfMajorPerformanceCaveat: true,
      });
      if (!context) return;
      shaderRequested = true;
      import("@/utils/motion-shader.ts")
        .then(({ createMotionShader }) => {
          const active = createMotionShader(canvas, context);
          active.resize(view.width, view.height);
          shader = active;
          return uploadTextures(active);
        })
        .catch(console.warn);
    };

    const launchMotion = (key: number) => {
      const { motion } = config;
      const { x, y, strength: amount } = launches[key];
      const fade = clamp(
        (amount - motion.settled) / (motion.settled * 3),
        0,
        1,
      );
      const settledAmount = amount * fade;
      return {
        blurX: x * motion.blur * amount,
        blurY: y * motion.blur * amount,
        shift: motion.shift * settledAmount,
        lagX: x * settledAmount * motion.blur * motion.lag,
        lagY: y * settledAmount * motion.blur * motion.lag,
        bendX: x * settledAmount * motion.bend,
        bendY: y * settledAmount * motion.bend,
      };
    };

    const trailItems = (active: MotionShader) => {
      const visible = [];
      for (const [key, item] of items.entries()) {
        if (!item.classList.contains("is-active")) continue;
        if (!active.has(key)) return null;
        const { x, y, order } = places[key];
        visible.push({
          key,
          left: origin.x + x - itemSize.width / 2,
          top: origin.y + y - itemSize.height / 2,
          width: itemSize.width,
          height: itemSize.height,
          order,
          motion: launchMotion(key),
        });
      }
      return visible.sort((a, b) => a.order - b.order);
    };

    const setDrawing = (value: boolean) => {
      if (value === drawing) return;
      drawing = value;
      trail.classList.toggle("is-drawing", drawing);
    };

    const syncDrawing = (elapsed: number) => {
      const { motion } = config;
      const time = Math.max(elapsed, 1);
      const frames = time / (1000 / 60);
      const blend = 1 - Math.exp(-time / motion.smoothing);
      velocity.x += (travel.x / frames - velocity.x) * blend;
      velocity.y += (travel.y / frames - velocity.y) * blend;
      const driftBlend = 1 - Math.exp(-time / motion.driftSmoothing);
      driftVelocity.x += (travel.x / frames - driftVelocity.x) * driftBlend;
      driftVelocity.y += (travel.y / frames - driftVelocity.y) * driftBlend;
      travel.x = 0;
      travel.y = 0;
      const speed = Math.hypot(velocity.x, velocity.y);
      if (speed > 1) {
        heading.x = velocity.x / speed;
        heading.y = velocity.y / speed;
      }

      const active = shader;
      const allowed = active && !active.isLost() && !prefersPlainImages();
      if (allowed) {
        const range = clamp(
          (speed - motion.minSpeed) / (motion.maxSpeed - motion.minSpeed),
          0,
          1,
        );
        const goal = range * range * (3 - 2 * range);
        const rate = goal > strength ? motion.attack : motion.release;
        strength += (goal - strength) * (1 - (1 - rate) ** frames);
      } else {
        strength = 0;
      }

      const fadeRate =
        speed > motion.minSpeed ? motion.fadeMoving : motion.fadeResting;
      const fade = allowed ? (1 - fadeRate) ** frames : 0;
      let level = 0;
      for (const [key, launch] of launches.entries()) {
        launch.strength *= fade;
        if (items[key].classList.contains("is-active")) {
          level = Math.max(level, launch.strength);
        }
      }

      const ready = allowed && level > motion.settled * (drawing ? 1 : 4);
      const visible = ready ? trailItems(active) : null;
      if (visible) active?.draw(visible);
      setDrawing(!!visible);
    };

    const advance = () => {
      items.forEach((item, i) =>
        item.classList.toggle("is-active", i === index),
      );
      index = (index + 1) % total;
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      toggle?.setAttribute("aria-pressed", String(playing));
      if (flipTimer) {
        window.clearInterval(flipTimer);
        flipTimer = null;
      }
      if (playing) flipTimer = window.setInterval(advance, config.flipMs);
    };

    const showImages = (points: { x: number; y: number; age: number }[]) => {
      const rect = trail.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const drift = reducedMotionQuery.matches ? 0 : config.motion.drift;
      const keep = 1 - config.motion.friction;
      for (const { x, y, age } of points) {
        const item = items[index];
        const push = {
          x: driftVelocity.x * drift,
          y: driftVelocity.y * drift,
        };
        const offsetX = clamp(
          x - centerX + push.x * age,
          room.left,
          room.right,
        );
        const offsetY = clamp(
          y - centerY + push.y * age,
          room.top,
          room.bottom,
        );
        push.x *= keep ** age;
        push.y *= keep ** age;
        item.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
        item.style.zIndex = String(stackTop);
        places[index] = { x: offsetX, y: offsetY, order: stackTop };
        launches[index] = { x: heading.x, y: heading.y, strength };
        drifts[index] = push;
        stackTop += 1;
        item.classList.add("is-active");
        const existing = timers.get(item);
        if (existing) window.clearTimeout(existing);
        timers.set(
          item,
          window.setTimeout(
            () => item.classList.remove("is-active"),
            config.life,
          ),
        );
        index = (index + 1) % total;
      }
    };

    const coast = (frames: number) => {
      const keep = (1 - config.motion.friction) ** frames;
      for (const [key, item] of items.entries()) {
        const drift = drifts[key];
        if (Math.abs(drift.x) + Math.abs(drift.y) < 0.01) continue;
        if (!item.classList.contains("is-active")) {
          drift.x = 0;
          drift.y = 0;
          continue;
        }
        const place = places[key];
        place.x = clamp(place.x + drift.x * frames, room.left, room.right);
        place.y = clamp(place.y + drift.y * frames, room.top, room.bottom);
        drift.x *= keep;
        drift.y *= keep;
        item.style.transform = `translate(${place.x}px, ${place.y}px)`;
      }
    };

    const spawn = (frames: number) => {
      const { threshold } = config;
      const dx = pointer.x - last.x;
      const dy = pointer.y - last.y;
      const distance = Math.hypot(dx, dy);
      const moved = Math.hypot(
        pointer.x - lastPointer.x,
        pointer.y - lastPointer.y,
      );
      lastPointer.x = pointer.x;
      lastPointer.y = pointer.y;
      if (distance < threshold) return;
      const steps = Math.floor(distance / threshold);
      const unitX = dx / distance;
      const unitY = dy / distance;
      const points = [];
      for (let step = Math.max(1, steps - total + 1); step <= steps; step++) {
        const behind = distance - threshold * step;
        points.push({
          x: last.x + unitX * threshold * step,
          y: last.y + unitY * threshold * step,
          age: moved > 0 ? clamp(behind / moved, 0, 1) * frames : 0,
        });
      }
      showImages(points);
      last.x += unitX * threshold * steps;
      last.y += unitY * threshold * steps;
    };

    const render = (now: number) => {
      const elapsed = Math.min(now - lastTime, 50);
      const frames = elapsed / (1000 / 60);
      lastTime = now;
      coast(frames);
      if (hasMoved) spawn(frames);
      syncDrawing(elapsed);
      frame = window.requestAnimationFrame(render);
    };

    const teardown = () => {
      if (frame) {
        window.cancelAnimationFrame(frame);
        frame = null;
      }
      if (flipTimer) {
        window.clearInterval(flipTimer);
        flipTimer = null;
      }
      if (mouseHandler) {
        scope.removeEventListener("mousemove", mouseHandler);
        mouseHandler = null;
      }
      items.forEach((item) => {
        const existing = timers.get(item);
        if (existing) window.clearTimeout(existing);
        item.classList.remove("is-active");
        item.style.transform = "";
        item.style.zIndex = "";
      });
      index = 0;
      stackTop = 1;
      hasMoved = false;
      moveTime = -Infinity;
      travel.x = 0;
      travel.y = 0;
      velocity.x = 0;
      velocity.y = 0;
      driftVelocity.x = 0;
      driftVelocity.y = 0;
      strength = 0;
      setDrawing(false);
    };

    const run = (flipbook: boolean) => {
      teardown();
      trail.classList.toggle("is-flipbook", flipbook);
      if (flipbook) {
        advance();
        setPlaying(playing);
        return;
      }
      mouseHandler = (event) => {
        if (event.timeStamp - moveTime < config.motion.pause) {
          travel.x += event.clientX - pointer.x;
          travel.y += event.clientY - pointer.y;
        }
        moveTime = event.timeStamp;
        pointer.x = event.clientX;
        pointer.y = event.clientY;
        if (!hasMoved) {
          last.x = pointer.x;
          last.y = pointer.y;
          lastPointer.x = pointer.x;
          lastPointer.y = pointer.y;
          hasMoved = true;
        }
      };
      scope.addEventListener("mousemove", mouseHandler);
      lastTime = performance.now();
      frame = window.requestAnimationFrame(render);
    };

    let currentFlip: boolean | null = null;
    const applyMode = () => {
      const flipbook = !trailQuery.matches;
      if (flipbook === currentFlip) return;
      currentFlip = flipbook;
      run(flipbook);
    };

    let settleTimer: number | null = null;
    const scheduleApply = () => {
      if (settleTimer) window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(applyMode, 120);
    };

    trailQuery.addEventListener("change", scheduleApply);
    reducedMotionQuery.addEventListener("change", () => {
      playing = !reducedMotionQuery.matches;
      if (currentFlip !== null) run(currentFlip);
    });
    toggle?.addEventListener("click", () => setPlaying(!playing));
    applyMode();

    const observer = new ResizeObserver(measure);
    observer.observe(scope);
    observer.observe(trail);
    if (nav) observer.observe(nav);
    for (const query of [trailQuery, ...plainQueries]) {
      query.addEventListener("change", startShader);
    }
    if (document.readyState === "complete") startShader();
    else window.addEventListener("load", startShader, { once: true });
  }
</script>

<style is:global>
  @property --_bounds-inset {
    syntax: "<length>";
    inherits: false;
    initial-value: 0;
  }

  @layer components {
    .image-trail_wrap {
      --_img-width: 18.75rem;
      --_img-ratio: 4/5;
      --_bounds-inset: var(--site-margin);
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;

      /* Trail */
      .image-trail_item {
        opacity: 0;
        width: var(--_img-width);
        will-change: transform, opacity;
        aspect-ratio: var(--_img-ratio);
        position: absolute;

        &.is-active {
          opacity: 1;
        }
      }

      .image-trail_canvas {
        position: absolute;
        max-width: none;
        visibility: hidden;
      }

      &.is-drawing {
        .image-trail_item {
          opacity: 0;
        }
        .image-trail_canvas {
          visibility: visible;
        }
      }

      /* Centred flipbook */
      .image-trail_controls {
        display: none;
        justify-content: center;
        align-items: center;
        position: absolute;
        inset: auto 0 0;
        z-index: 3;
        height: 1cap;
      }

      &.is-flipbook {
        --_img-width: min(58svh * var(--_img-ratio), 70vw);
        z-index: auto;

        .image-trail_item {
          translate: 0 var(--_center-offset, 0);
        }

        .image-trail_canvas {
          display: none;
        }

        .image-trail_controls {
          display: flex;
        }
      }

      /* Stacked */
      @media (width < 48rem) or ((height < 30rem) and (hover: none)) {
        position: relative;
        aspect-ratio: var(--_img-ratio);
        width: 100%;
        max-height: 100svh;

        &.is-flipbook {
          --_img-width: min(85svh * var(--_img-ratio), 68vw);

          .image-trail_item {
            translate: none;
          }
        }

        .image-trail_controls {
          justify-content: flex-end;
          align-items: flex-end;
          inset: auto;
          width: var(--_img-width);
          height: auto;
          aspect-ratio: var(--_img-ratio);
        }
      }
    }
  }
</style>
