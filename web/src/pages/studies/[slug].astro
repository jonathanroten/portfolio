---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import HeroStudy from "@/components/content/HeroStudy.astro";
import NextStudy from "@/components/content/NextStudy.astro";
import { galleryCrops } from "@/utils/sanity.ts";
import { getStudies, type Study } from "@/utils/studies.ts";

export async function getStaticPaths() {
  const studies = await getStudies();
  return studies.map((study, i) => ({
    params: { slug: study.slug },
    props: { study, number: i + 1, next: studies[(i + 1) % studies.length] },
  }));
}

interface Props {
  study: Study;
  /** Position in the project order. */
  number: number;
  next: Study;
}

const { study, number, next } = Astro.props;
const hero = galleryCrops.fullWidth;
const standIn = "/stand-in.svg";
---

<Layout
  title={study.title}
  description={study.description}
  theme="dark"
  footer="none"
>
  <!-- Hero -->
  <Section
    class="padding-top-5"
    paddingBottom="none"
    containerClass="gap-gutter"
  >
    <HeroStudy
      number={number}
      heading={study.title}
      description={study.description}
      services={study.services}
      engagement={study.engagement}
    />
    <Img
      src={standIn}
      variant="full-width"
      width={hero.width}
      height={Math.round(hero.width / hero.ratio)}
      loading="eager"
      fetchPriority="high"
    />
  </Section>
  <!-- Problem, then solution -->
  {
    [
      {
        heading: "Problem",
        text: study.problem,
        gallery: study.problemGallery,
      },
      {
        heading: "Solution",
        text: study.solution,
        gallery: study.solutionGallery,
      },
    ].map((part) => (
      <Section paddingTop="small" paddingBottom="none">
        <Grid medium={2} class="gap-1">
          <ContentWrapper class="grid-column-full padding-bottom-5">
            <Heading tag="h2" class="sr-only">
              {part.heading}
            </Heading>
            <Paragraph variant="main" maxWidth={95}>
              {part.text}
            </Paragraph>
          </ContentWrapper>
          {part.gallery.map((image) => {
            const full = image.layout === "fullWidth";
            const crop = galleryCrops[image.layout];
            return (
              <Img
                src={standIn}
                variant="full-width"
                width={crop.width}
                height={Math.round(crop.width / crop.ratio)}
                class={full ? "grid-column-full" : undefined}
              />
            );
          })}
        </Grid>
      </Section>
    ))
  }
  <!-- Next -->
  <Section paddingBottom="none">
    <NextStudy heading={next.title} href={`/studies/${next.slug}`} />
  </Section>
</Layout>
