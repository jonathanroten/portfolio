---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import FormattedDate from "@/components/utility/FormattedDate.astro";
import LiveClock from "@/components/utility/LiveClock.astro";
import ImageTrail from "@/components/content/ImageTrail.astro";
import ProjectFeature from "@/components/content/ProjectFeature.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import ProjectSlider from "@/components/content/ProjectSlider.astro";

import {
  getDescription,
  getHeroImages,
  getProjects,
  imageUrl,
} from "@/utils/sanity.ts";

const today = new Date();
const brandProjects = await getProjects("brand");
const interactiveProjects = await getProjects("interactive");
const heroImages = await getHeroImages();
const description = await getDescription();
---

<Layout theme="dark">
  <Section
    paddingBottom="even"
    containerClass="flex-grow"
    paddingTop="large"
    class="flex-grow full-height"
  >
    <ContentWrapper class="flex-grow justify-content-end zindex-2">
      <Heading tag="h1" class="sr-only">Jonathan Roten's Portfolio</Heading>
      <Paragraph variant="h2" class="text-accent"
        >Hi, I&apos;m <span>Jonathan</span>.</Paragraph
      >
      <Paragraph variant="h2" maxWidth={30} class="text-accent margin-block-8">
        {
          description.runs.map((run) =>
            run.highlight ? <span>{run.text}</span> : run.text,
          )
        }
      </Paragraph>
      <div class="width-full display-inline-flex justify-content-between">
        <span class="text-style-h6"
          ><FormattedDate
            date={today}
            format={{ month: "long", day: "2-digit", year: "numeric" }}
          /></span
        ><span class="text-style-h6"><LiveClock /></span>
      </div>
    </ContentWrapper>
    <ImageTrail>
      {
        heroImages.map((image, i) => (
          <Img
            src={imageUrl(image, 800, 4 / 5)}
            loading="eager"
            fetchPriority={i === 0 ? "high" : undefined}
          />
        ))
      }
    </ImageTrail>
  </Section>
  <Section paddingTop="none" paddingBottom="none">
    <ProjectFeature projects={brandProjects} />
  </Section>
  <Section
    paddingTop="large"
    paddingBottom="medium"
    containerClass="flex-grow"
    class="flex-grow"
  >
    <Accordion single openFirst>
      {
        interactiveProjects.map((project) => (
          <AccordionItem
            variant="alternate"
            heading={project.title}
            headingTag="h2"
          >
            <ProjectSlider project={project} />
          </AccordionItem>
        ))
      }
    </Accordion>
  </Section>
</Layout>
